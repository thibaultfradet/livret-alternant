{% extends 'base.html.twig' %}

{% block title %}Page introuvable{% endblock %}

{% block body %}
<div class="page-body d-flex align-items-center">
    <div class="container text-center py-6">

        <div class="mb-4" style="font-size:8rem;font-weight:800;line-height:1;color:#e8edf2;letter-spacing:-4px;">
            404
        </div>

        <h1 class="fw-bold text-primary mb-3" style="font-size:2rem;">
            Page introuvable
        </h1>

        <p class="text-secondary mb-5" style="max-width:420px;margin:0 auto;">
            La page que vous cherchez n'existe pas ou a été déplacée.
        </p>

        <div class="d-flex gap-3 justify-content-center">
            <a href="/" class="btn btn-primary">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24"
                     stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M5 12l-2 0l9 -9l9 9l-2 0" />
                    <path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7" />
                    <path d="M9 21v-6a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v6" />
                </svg>
                Retour à l'accueil
            </a>
            <button onclick="history.back()" class="btn btn-secondary">
                Revenir en arrière
            </button>
        </div>

    </div>
</div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}
    Paramétrage
{% endblock %}

{% block body %}
    {% set addLink = '' %}
    {% set addTxt = '' %}
    {% set dropdownLink = '' %}
    {% set dropdownContent = '' %}
    {% set tabContent = '' %}

    {# Define add buttons / dropdowns based on currentTab #}
    {% if currentTab == 'classroom' %}
        {% set addTxt = 'Nouvelle classe' %}
        {% set addLink = path('app_classroom_new') %}
        {% set tabContent = 'trainings/parameters/tab_classroom.html.twig' %}
    {% elseif currentTab == 'diploma' %}
        {% set addTxt = 'Nouveau diplôme' %}
        {% set addLink = path('app_diploma_new') %}
        {% set tabContent = 'trainings/parameters/tab_diploma.html.twig' %}
    {% elseif currentTab == 'period' %}
        {% set addTxt = 'Nouvelle période' %}
        {% set addLink = path('app_period_new') %}
        {% set tabContent = 'trainings/parameters/tab_period.html.twig' %}
    {% elseif currentTab == 'schoolYear' %}
        {% set addTxt = 'Nouvelle année scolaire' %}
        {% set addLink = path('app_school_year_new') %}
        {% set tabContent = 'trainings/parameters/tab_schoolYear.html.twig' %}
    {% elseif currentTab == 'behavior' %}
        {% set addTxt = 'Nouveau comportement' %}
        {% set addLink = path('training_parameters_behavior_create') %}
        {% set tabContent = 'trainings/parameters/tab_behavior.html.twig' %}
    {% elseif currentTab == 'user' %}
        {% set tabContent = 'trainings/parameters/tab_user.html.twig' %}
    {% elseif currentTab == 'skill' %}
        {% set tabContent = 'trainings/parameters/tab_skill.html.twig' %}
    {% endif %}

    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <h1 class="fw-bold text-primary mb-2 display-5 text-center">
                        Paramétrage
                    </h1>
                    {% if activeSchoolYear is defined and activeSchoolYear %}
                        <p class="text-muted text-center mb-4">{{ activeSchoolYear.label }}</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="page-body">
        <div class="container-xl">
            <div class="row row-deck row-cards">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            {% include('trainings/parameters/tabs_menu.html.twig') %}
                        </div>
                        <div class="card-body">
                            <div class="tab-content">
                                <div class="tab-pane active show">
                                    {% include(tabContent) %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts_bottom %}
     {{ encore_entry_script_tags('datatable') }}
{% endblock %}
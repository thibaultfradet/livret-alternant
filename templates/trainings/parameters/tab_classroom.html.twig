<div class="table-responsive">
    <table class="table card-table table-vcenter text-nowrap datatable" id="classroomTable" style="width:100%">
        <thead>
            <tr>
                <th>Diplôme</th>
                <th>Professeur référent</th>
                <th>Référent de formation</th>
                <th class="text-end w-1">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for classroom in classrooms %}
                <tr>
                    <td>{{ classroom.diploma.label }}</td>

                    {# Professor referent column #}
                    <td class="gap-2">
                        {% if classroom.principalTeacher %}
                            {{ classroom.principalTeacher.lastName }}
                            {{ classroom.principalTeacher.firstName }}
                        {% else %}
                            N/A
                        {% endif %}

                        {# Edit principal teacher #}
                        <a href="{{ path('app_classroom_tp', {'id': classroom.id}) }}"
                           class="btn btn-ghost-warning btn-icon btn-sm ms-2"
                           title="Modifier le professeur référent">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                 fill="currentColor" class="bi bi-pencil" viewBox="0 0 16 16">
                                <path d="M12.146.854a.5.5 0 0 1 .708 0l2.292 2.292a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10z"/>
                            </svg>
                        </a>
                    </td>

                    {# Training contact column #}
                    <td>
                        {% if classroom.trainingContactName %}
                            <div>
                                <strong>{{ classroom.trainingContactName }}</strong>
                            </div>
                            {% if classroom.trainingContactPhone %}
                                <div class="text-muted small">
                                    {{ classroom.trainingContactPhone }}
                                </div>
                            {% endif %}
                        {% else %}
                            N/A
                        {% endif %}

                        {# Edit training contact #}
                        <a href="{{ path('app_classroom_training_contact', {'id': classroom.id}) }}"
                           class="btn btn-ghost-warning btn-icon btn-sm ms-2"
                           title="Modifier le référent de formation">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                 fill="currentColor" class="bi bi-pencil" viewBox="0 0 16 16">
                                <path d="M12.146.854a.5.5 0 0 1 .708 0l2.292 2.292a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1 .11-.168l10-10z"/>
                            </svg>
                        </a>
                    </td>
                    <td class="text-end">
                        <div class="btn-list flex-nowrap justify-content-end">
                            {# Button for files with a folder icon #}
                            <a href="{{ path('app_classroom_files', {'id': classroom.id}) }}"
                            class="btn btn-primary me-1"
                            title="Modifier les fichiers">
                               <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><!-- Icon from Material Symbols by Google - https://github.com/google/material-design-icons/blob/master/LICENSE --><path fill="currentColor" d="M4 20q-.825 0-1.412-.587T2 18V6q0-.825.588-1.412T4 4h6l2 2h8q.825 0 1.413.588T22 8v10q0 .825-.587 1.413T20 20z"/></svg>
                            </a>

                            {# Button for terms with a file-text icon #}
                            <a href="{{ path('app_classroom_terms', {'id': classroom.id}) }}"
                            class="btn btn-warning me-1"
                            title="Modifier les conditions d'utilisation">
                               <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><!-- Icon from Material Symbols by Google - https://github.com/google/material-design-icons/blob/master/LICENSE --><path fill="currentColor" d="M15.25 18.75q.3 0 .525-.225T16 18t-.225-.525t-.525-.225t-.525.225T14.5 18t.225.525t.525.225m2.75 0q.3 0 .525-.225T18.75 18t-.225-.525T18 17.25t-.525.225t-.225.525t.225.525t.525.225m2.75 0q.3 0 .525-.225T21.5 18t-.225-.525t-.525-.225t-.525.225T20 18t.225.525t.525.225M5 21q-.825 0-1.412-.587T3 19V5q0-.825.588-1.412T5 3h14q.825 0 1.413.588T21 5v6.7q-.475-.225-.975-.387T19 11.075V5H5v14h6.05q.075.55.238 1.05t.387.95zm0-3v1V5v6.075V11zm2-1h4.075q.075-.525.238-1.025t.362-.975H7zm0-4h6.1q.8-.75 1.788-1.25T17 11.075V11H7zm0-4h10V7H7zm11 14q-2.075 0-3.537-1.463T13 18t1.463-3.537T18 13t3.538 1.463T23 18t-1.463 3.538T18 23"/></svg>
                            </a>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="text-center text-muted">
                        Aucune classe disponible pour l'année scolaire active.
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
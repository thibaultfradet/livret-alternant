<div class="table-responsive">
    <table class="table card-table table-vcenter text-nowrap datatable" id="classroomTable" style="width:100%">
        <thead>
            <tr>
                <th>Diplôme</th>
                <th>Professeur référent</th>
                <th class="text-end w-1">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for classroom in classrooms %}
                <tr>
                    <td>{{ classroom.diploma.label }}</td>
                    <td class="gap-2 ">
                        {% if classroom.principalTeacher %}
                            {{ classroom.principalTeacher.lastName }} {{ classroom.principalTeacher.firstName }}
                        {% else %}
                            N/A
                        {% endif %}
                        <!-- Crayon toujours présent -->
                        <a href="{{ path('app_classroom_tp', {'id': classroom.id}) }}" class="btn btn-ghost-warning btn-icon btn-sm" title="Modifier">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil" viewBox="0 0 16 16">
                                <path d="M12.146.854a.5.5 0 0 1 .708 0l2.292 2.292a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 3L13 4.793 12.5 5.293 10.707 3.5 11.207 3zM3 10.707V13h2.293l9.147-9.146-2.293-2.293L3 10.707z"/>
                            </svg>
                        </a>
                    </td>
                    <td class="text-end">
                        <div class="btn-list flex-nowrap justify-content-end">
                            <a href="{{ path('app_classroom_files', {'id': classroom.id}) }}" 
                               class="btn btn-ghost-primary me-1">Modifier les fichiers</a>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3" class="text-center text-muted">Aucune classe disponible pour l'année scolaire active.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
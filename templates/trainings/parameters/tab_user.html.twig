<div class="row g-2 mb-4">
    <div class="col-6 col-md-3">
        <button type="button" class="btn btn-info w-100" data-bs-toggle="modal" data-bs-target="#sendLinksModal">
            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" /><path d="M3 7l9 6l9 -6" /></svg>
            Lien de connexion
        </button>
    </div>
    <div class="col-6 col-md-3">
        <a href="{{ path('app_excel_user_import') }}" class="btn btn-success w-100">
            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 17v2a1 1 0 0 0 1 1h14a1 1 0 0 0 1 -1v-2" /><path d="M7 9l5 -5l5 5" /><path d="M12 4v12" /></svg>
            Importer
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a href="{{ path('app_user_list_modes') }}" class="btn btn-warning w-100">
            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><circle cx="16" cy="12" r="2" /><path d="M4 12a8 8 0 1 0 16 0a8 8 0 1 0 -16 0" /></svg>
            Modalité d'alternance
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a href="{{ path('app_user_new') }}" class="btn btn-primary w-100">
            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 5l0 14" /><path d="M5 12l14 0" /></svg>
            Nouvel utilisateur
        </a>
    </div>
</div>

<div class="table-responsive">
    <table class="table card-table table-vcenter text-nowrap datatable" id="users-table" style="width:100%">
        <thead>
            <tr>
                <th>Email</th>
                <th>Rôles</th>
                <th>Prénom</th>
                <th>Nom</th>
                <th>Classe</th>
                <th>Statut</th>
                <th class="text-center w-1 ">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for user in users %}
                <tr class="{% if user.disabledAt %}table-danger{% endif %}">
                    <td class="text-center">{{ user.email }}</td>

                    <td class="text-center">{{ user.cleanedRoles|map(r => r == 'ROLE_TTM' ? 'Équipe pédagogique' 
                                             : r == 'ROLE_PT' ? 'Professeur référent'
                                             : r == 'ROLE_TUTOR' ? 'Tuteur'
                                             : r == 'ROLE_STUDENT' ? 'Alternant'
                                             : r == 'ROLE_ADMIN' ? 'Administrateur'
                                             : r)|join(', ') }}</td>
                    <td class="text-center">{{ user.firstName }}</td>
                    <td class="text-center">{{ user.lastName }}</td>
                    <td class="text-center">
                        {% if user.classroom %}
                            {{ user.classroom.diploma.label }} ({{ user.classroom.schoolYear.label }})
                        {% else %}
                            -
                        {% endif %}
                    <td class="text-center">
                        {% if user.disabledAt %}
                            Désactivé
                        {% else %}
                            Actif
                        {% endif %}
                    </td>
                    <td class="text-center">
                        <div class="btn-list d-flex flex-nowrap justify-content-center gap-1">                            
                            {# show #}
                            <a href="{{ path('app_user_show', {'id': user.id}) }}" class="btn btn-primary btn-icon" title="Voir">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye" viewBox="0 0 16 16">
                                    <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zm-8 4a4 4 0 1 1 0-8 4 4 0 0 1 0 8z"/>
                                    <path d="M8 5a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/>
                                </svg>
                            </a>
                            {# Edit #}
                            <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-warning btn-icon" title="Modifier">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil" viewBox="0 0 16 16">
                                    <path d="M12.146.854a.5.5 0 0 1 .708 0l2.292 2.292a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 3L13 4.793 12.5 5.293 10.707 3.5 11.207 3zM3 10.707V13h2.293l9.147-9.146-2.293-2.293L3 10.707z"/>
                                </svg>
                            </a>
                            {# Disable #}
                            {% if not user.disabledAt %}
                                <form class="d-inline" method="post" action="{{ path('app_user_disable', {'id': user.id}) }}" onsubmit="return confirmDisable();">
                                    <input type="hidden" name="_token" value="{{ csrf_token('disable' ~ user.id) }}">
                                    <button type="submit" class="btn btn-danger btn-icon" title="Désactiver">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-slash-circle" viewBox="0 0 16 16">
                                            <path d="M8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14zm0-1A6 6 0 1 1 8 2a6 6 0 0 1 0 12z"/>
                                            <path d="M4.646 4.646a.5.5 0 0 1 .708 0L11 10.293a.5.5 0 0 1-.708.708L4.646 5.354a.5.5 0 0 1 0-.708z"/>
                                        </svg>
                                    </button>
                                </form>
                            {% endif %}
                        </div>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<script>
function confirmDisable() {
    return confirm("Êtes-vous sûr de vouloir supprimer cet utilisateur ?") &&
           confirm("Cette action est irréversible. Confirmez à nouveau pour continuer.");
}
</script>

{# Modal Lien de connexion #}
<div class="modal fade" id="sendLinksModal" tabindex="-1" aria-labelledby="sendLinksModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="sendLinksModalLabel">
                    Envoyer un lien de connexion
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form method="POST" action="{{ path('training_parameters_send_welcome_emails') }}"
                      id="sendLinksForm" onsubmit="return confirmSendLinks();">
                    <input type="hidden" name="_token" value="{{ csrf_token('send_welcome_emails') }}">

                    <p class="text-muted mb-3">
                        Sélectionnez les alternants et tuteurs à qui envoyer un email de bienvenue avec leur lien de définition de mot de passe.
                    </p>

                    {# Search bar #}
                    <div class="mb-3">
                        <input type="text" id="sendLinksSearch" class="form-control"
                               placeholder="Rechercher par nom, prénom ou email…"
                               oninput="filterSendLinksRows(this.value)">
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle" id="sendLinksTable">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:40px;">
                                        <input type="checkbox" class="form-check-input" id="selectAllSendLinks" title="Tout sélectionner / désélectionner">
                                    </th>
                                    <th>Nom</th>
                                    <th>Prénom</th>
                                    <th>Email</th>
                                    <th>Rôle</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for u in sendableUsers %}
                                    <tr class="send-links-row"
                                        data-search="{{ (u.lastName ~ ' ' ~ u.firstName ~ ' ' ~ u.email)|lower }}">
                                        <td>
                                            <input type="checkbox" name="user_ids[]"
                                                   value="{{ u.id }}" class="form-check-input send-links-checkbox">
                                        </td>
                                        <td>{{ u.lastName }}</td>
                                        <td>{{ u.firstName }}</td>
                                        <td>{{ u.email }}</td>
                                        <td>
                                            {{ u.cleanedRoles|map(r => r == 'ROLE_TUTOR' ? 'Tuteur'
                                                : r == 'ROLE_STUDENT' ? 'Alternant' : r)|join(', ') }}
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="5" class="text-center text-muted">
                                            Aucun alternant ou tuteur disponible.
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="submit" form="sendLinksForm" class="btn btn-info">
                    Envoyer les liens de connexion
                </button>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    var masterCb = null;

    document.getElementById('sendLinksModal').addEventListener('shown.bs.modal', function () {
        masterCb = document.getElementById('selectAllSendLinks');
        masterCb.addEventListener('change', function () {
            document.querySelectorAll('#sendLinksTable .send-links-row').forEach(function (row) {
                if (row.style.display !== 'none') {
                    row.querySelector('.send-links-checkbox').checked = masterCb.checked;
                }
            });
        });
        document.querySelectorAll('.send-links-checkbox').forEach(function (cb) {
            cb.addEventListener('change', updateMaster);
        });
    });

    function updateMaster() {
        if (!masterCb) return;
        var visible = Array.from(document.querySelectorAll('#sendLinksTable .send-links-row'))
            .filter(function (r) { return r.style.display !== 'none'; })
            .map(function (r) { return r.querySelector('.send-links-checkbox'); });
        var checkedCount = visible.filter(function (cb) { return cb.checked; }).length;
        masterCb.indeterminate = checkedCount > 0 && checkedCount < visible.length;
        masterCb.checked = checkedCount === visible.length && visible.length > 0;
    }

    window.filterSendLinksRows = function (query) {
        var q = query.toLowerCase();
        document.querySelectorAll('#sendLinksTable .send-links-row').forEach(function (row) {
            row.style.display = row.dataset.search.includes(q) ? '' : 'none';
        });
        updateMaster();
    };

    window.confirmSendLinks = function () {
        var checked = document.querySelectorAll('#sendLinksTable .send-links-checkbox:checked');
        if (checked.length === 0) {
            alert('Veuillez sélectionner au moins un utilisateur.');
            return false;
        }
        return confirm('Vous allez envoyer ' + checked.length + ' email(s) de bienvenue avec un lien de définition de mot de passe. Confirmer ?');
    };
}());
</script>
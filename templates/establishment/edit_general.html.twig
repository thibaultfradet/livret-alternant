{# templates/establishment/edit_general.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Modifier les informations principales du centre{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h1 class="fw-bold text-primary mb-5 display-5 text-center">
                Modifier les informations principales du centre
            </h1>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">

            {{ form_start(form) }}

            <div class="mb-3">
                {{ form_label(form.name, null, {'label_attr': {'class': 'fw-bold'}}) }}
                {{ form_widget(form.name, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.name) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.termsConditionsApprentissage, null, {'label_attr': {'class': 'fw-bold'}}) }}
                {{ form_widget(form.termsConditionsApprentissage, {'attr': {'class': 'summernote'}}) }}
                {{ form_errors(form.termsConditionsApprentissage) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.termsConditionsPro, null, {'label_attr': {'class': 'fw-bold'}}) }}
                {{ form_widget(form.termsConditionsPro, {'attr': {'class': 'summernote'}}) }}
                {{ form_errors(form.termsConditionsPro) }}
            </div>

            <div class="d-flex justify-content-between my-4">
                <a href="{{ path('app_establishment_view') }}" class="btn btn-outline-secondary">
                    Retour
                </a>
                <button class="btn btn-primary">
                    Enregistrer
                </button>
            </div>

            {{ form_end(form) }}

        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<link href="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function () {
    $('.summernote').summernote({
        height: 200,
        placeholder: 'Entrez les conditions générales...',
    });
});
</script>
{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}Modifier le centre de formation{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h1 class="fw-bold text-primary mb-5 display-5 text-center">
                Modifier le centre de formation
            </h1>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            {{ form_start(form) }}

            {# --- Informations générales --- #}
            <h4 class="mb-3">Informations générales</h4>
            <div class="border rounded p-3 mb-4" style="background-color: #f9f9f9;">
                {{ form_row(form.generalInfo) }}
            </div>

            {# Directeur #}
            <h4 class="mb-3">Directeur</h4>
            <div class="border rounded p-3 mb-4" style="background-color: #f9f9f9;">
                <div class="row mb-3">
                    <div class="col-md-6">
                        {{ form_row(form.director.firstName) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.director.lastName) }}
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        {{ form_row(form.director.email) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.director.phone) }}
                    </div>
                </div>
            </div>

            {# Directrice du campus #}
            <h4 class="mb-3">Directrice du campus</h4>
            <div class="border rounded p-3 mb-4" style="background-color: #f9f9f9;">
                <div class="row mb-3">
                    <div class="col-md-6">
                        {{ form_row(form.campusDirector.firstName) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.campusDirector.lastName) }}
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        {{ form_row(form.campusDirector.email) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.campusDirector.phone) }}
                    </div>
                </div>
            </div>

            {# Responsable de l’alternance #}
            <h4 class="mb-3">Responsable de l’alternance</h4>
            <div class="border rounded p-3 mb-4" style="background-color: #f9f9f9;">
                <div class="row mb-3">
                    <div class="col-md-6">
                        {{ form_row(form.alternanceManager.firstName) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.alternanceManager.lastName) }}
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        {{ form_row(form.alternanceManager.email) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.alternanceManager.phone) }}
                    </div>
                </div>
            </div>

            {# Référent handicap #}
            <h4 class="mb-3">Référent handicap</h4>
            <div class="border rounded p-3 mb-4" style="background-color: #f9f9f9;">
                <div class="row mb-3">
                    <div class="col-md-6">
                        {{ form_row(form.handicapReferent.firstName) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.handicapReferent.lastName) }}
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        {{ form_row(form.handicapReferent.email) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.handicapReferent.phone) }}
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between my-4">
                <a href="{{ path('app_establishment_view') }}" class="btn btn-outline-secondary">
                    Retour
                </a>
                <button class="btn btn-primary">
                    Enregistrer
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
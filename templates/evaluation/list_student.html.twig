{% extends 'base.html.twig' %}

{% block title %}Mon livret{% endblock %}

{% block body %}
<div class="page-body d-flex">
  <div class="container py-6 d-flex flex-column gap-4">
    <h1 class="fw-bold text-primary mb-5 display-5 text-center">
      Périodes sans évaluation étudiante
    </h1>

    <div class="alert alert-info d-flex align-items-center" role="alert">
      <svg xmlns="http://www.w3.org/2000/svg" class="icon alert-icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M12 9v2m0 4v.01" />
          <path d="M5 19h14a2 2 0 0 0 1.73 -2.99l-7 -12a2 2 0 0 0 -3.46 0l-7 12a2 2 0 0 0 1.73 2.99" />
      </svg>
      <div>
          <a href="{{ path('app_student_evaluations', { 'student': student.id }) }}">
              Voir mon livret complet
          </a>
      </div>
    </div>

    {% if missingEvaluations is not empty %}
      <div class="alert alert-danger d-flex align-items-center" role="alert">
        <svg xmlns="http://www.w3.org/2000/svg" class="icon alert-icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M12 9v2m0 4v.01" />
          <path d="M5 19h14a2 2 0 0 0 1.73 -2.99l-7 -12a2 2 0 0 0 -3.46 0l-7 12a2 2 0 0 0 1.73 2.99" />
        </svg>
      <div>
        <strong>Attention :</strong> Une ou plusieurs évaluation sont manquantes.
      </div>
      </div>
      <div class="card shadow-sm">
        <div class="table-responsive">
          <table id="missingEvaluationsTable" class="table table-striped align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Nom de la période</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              {% for period in missingEvaluations %}
                <tr>
                  <td> Période {{ period.periodNumber }} ({{ period.startDate|date('d/m/Y') }} - {{ period.endDate|date('d/m/Y') }})</td>
                  <td class="text-end">
                    <a href="{{ path('app_create_student_evaluation', {'period': period.id}) }}"
                       class="btn btn-outline-primary ">
                      Créer l’évaluation
                    </a>
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    {% else %}
      <div class="w-100 text-center mt-4">
        {% if missingEvaluations is empty %}
          {% if student.classroom and student.classroom.schoolYear %}
            {% if not student.classroom.schoolYear.isActive %}
              <p class="text-muted fst-italic">
                Votre année scolaire n'est pas active. Aucune période n'est disponible pour l'évaluation.
              </p>
            {% else %}
              <p class="text-muted fst-italic">
              Toutes vos périodes ont une évaluation étudiante ou sont en attente d'une évaluation par votre tuteur.
            </p>
            {% endif %}
          {% endif %}
        {% endif %}      
      </div>
    {% endif %}
  </div>
</div>
{% endblock %}
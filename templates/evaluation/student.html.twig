{% extends 'base.html.twig' %}

{% block title %}Mon livret{% endblock %}

{% block body %}
<div class="page-body d-flex">
  <div class="container py-6 d-flex flex-column gap-4">

    {# --- PAGE TITLE --- #}
    <h1 class="fw-bold text-primary mb-5 display-5 text-center">
      Mon livret de l'alternant
    </h1>
    <h3 class="text-center mb-5">Période numéro {{ period.periodNumber }}</h3>

    {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': ''}}) }}

    {# --- REMARQUE --- #}
    <div class="card shadow-sm mb-4">
      <div class="card-header bg-light">
        <h5 class="card-title mb-0">Remarque</h5>
      </div>
      <div class="card-body">
        {{ form_widget(form.remarks, {'attr': {'class': 'form-control', 'rows': 5}}) }}
        {{ form_errors(form.remarks) }}
      </div>
    </div>

    {# --- BOUTON VALIDER --- #}
    <div class="d-flex justify-content-center mt-4">
      <button type="submit" id="submit-evaluation" class="btn btn-primary btn-lg px-5">
        {{ button_label|default('Valider mon évaluation') }}
      </button>
    </div>

    {# CSRF token seulement #}
    {{ form_widget(form._token) }}

    {{ form_end(form, {'render_rest': false}) }}

  </div>
</div>
{% endblock %}
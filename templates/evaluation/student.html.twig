{% extends 'base.html.twig' %}

{% block title %}Mon livret{% endblock %}

{% block body %}
<div class="container my-5">
    <h1 class="mb-4 text-center">Mon livret de l'alternant</b></h1>
    <h3 class="text-center">Période numéro {{period.periodNumber}}</h3>

    {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': ''}}) }}

    <div class="card shadow-sm mb-4 card-remark">
        <div class="card-header">
            <h5 class="card-title mb-0">Remarque</h5>
        </div>
        <div class="card-body">
            {{ form_widget(form.remarks) }}
            {{ form_errors(form.remarks) }}
        </div>
    </div>
    
    <div class="d-flex justify-content-center mt-4">
        <button class="btn btn-submit btn-lg px-5 bg-primary">{{ button_label|default('Valider mon évaluation') }}</button>
    </div>

    {{ form_widget(form._token) }}

    {{ form_end(form, {'render_rest': false}) }}
</div>
{% endblock %}

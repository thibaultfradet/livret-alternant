{% extends 'base.html.twig' %}

{% block title %}Sélection d'un alternant{% endblock %}

{% block body %}
<div class="page-body d-flex">
  <div class="container py-6 d-flex flex-column gap-4">
    <h1 class="fw-bold text-primary mb-5 display-5 text-center">
      Évaluez un alternant
    </h1>

    <form method="get" class="mb-4">
      <div class="card shadow-sm p-3">
        <div class="row g-3 align-items-center">
          <div class="col-md-6">
            <label for="diploma" class="form-label fw-bold">Diplôme</label>
            <select name="diploma" id="diploma" class="form-select" onchange="this.form.submit()">
              <option value="">-- Tous --</option>
              {% for id, label in diplomas %}
                <option value="{{ id }}" {% if id == selectedDiploma %}selected{% endif %}>{{ label }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="col-md-6">
            <label for="period" class="form-label fw-bold">Période</label>
            <select name="period" id="period" class="form-select" onchange="this.form.submit()">
              {% for p in allPeriods %}
                <option value="{{ p.id }}" {% if p.id == period.id %}selected{% endif %}>
                  Période {{ p.periodNumber }} ({{ p.startDate|date('d/m/Y') }} - {{ p.endDate|date('d/m/Y') }})
                </option>
              {% endfor %}
            </select>
          </div>
        </div>
      </div>
    </form>

    {% for student in students %}
      {% set alreadyEvaluated = false %}
      {% for te in student.tutorEvaluationsReceived %}
        {% if te.period.id == period.id %}
          {% set alreadyEvaluated = true %}
        {% endif %}
      {% endfor %}

      <div class="card shadow-sm">
        <div class="card-body d-flex justify-content-between align-items-center">
          <p class="mb-0 fw-bold">{{ student.firstName }} {{ student.lastName }} - {{ student.classroom.diploma.label }}</p>
          <div class="d-flex gap-2">
            {% if not alreadyEvaluated %}
              <a href="{{ path('app_create_evaluation', { 'student': student.id, 'period': period.id }) }}" class="btn btn-outline-primary">Noter</a>
            {% endif %}

            <a href="{{ path('app_student_evaluations', { 'student': student.id, 'period': period.id }) }}" class="btn btn-primary" target="_blank">
              Voir le livret
            </a>
          </div>
        </div>
      </div>
    {% else %}
      <div class="alert alert-info text-center">
        Aucun étudiant à évaluer pour ces filtres.
      </div>
    {% endfor %}
  </div>
</div>
{% endblock %}
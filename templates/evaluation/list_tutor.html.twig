{% extends 'base.html.twig' %}

{% block title %}Sélection d'un alternant{% endblock %}

{% block body %}
<div class="page-body d-flex">
  <div class="container py-6 d-flex flex-column gap-4">
    <h1 class="fw-bold text-primary mb-5 display-5 text-center">
      Sélectionner un alternant à évaluer
    </h1>


    {% if evaluations|length > 0 %}
      <div class="alert alert-danger d-flex align-items-center" role="alert">
        <svg xmlns="http://www.w3.org/2000/svg" class="icon alert-icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M12 9v2m0 4v.01" />
          <path d="M5 19h14a2 2 0 0 0 1.73 -2.99l-7 -12a2 2 0 0 0 -3.46 0l-7 12a2 2 0 0 0 1.73 2.99" />
        </svg>
        <div>
          <strong>Attention :</strong> Une ou plusieurs évaluations sont manquantes.
        </div>
      </div>
    {% endif %}
    <form method="get" class="mb-4">
      <div class="card shadow-sm p-3">
        <div class="row g-3 align-items-center">
          <div class="col-md-6">
            <label for="diploma" class="form-label fw-bold">Diplôme</label>
            <select name="diploma" id="diploma" class="form-select" onchange="this.form.submit()">
              <option value="">-- Tous --</option>
              {% for id, label in diplomas %}
                <option value="{{ id }}" {% if id == selectedDiploma %}selected{% endif %}>{{ label }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="col-md-6">
            <label for="period" class="form-label fw-bold">Période</label>
            <select name="period" id="period" class="form-select" onchange="this.form.submit()">
              {% for p in allPeriods %}
                <option value="{{ p.id }}" {% if p.id == period.id %}selected{% endif %}>
                  Période {{ p.periodNumber }} ({{ p.startDate|date('d/m/Y') }} - {{ p.endDate|date('d/m/Y') }})
                </option>
              {% endfor %}
            </select>
          </div>
        </div>
      </div>
    </form>

    

    {% for eval in evaluations %}
      <div class="card shadow-sm">
        <div class="card-body d-flex justify-content-between align-items-center">
          <p class="mb-0 fw-bold">{{ eval.label }}</p>
          <a href="{{ eval.route }}" class="btn btn-outline-primary">Noter</a>
        </div>
      </div>
    {% else %}
      <div class="alert alert-info text-center">
        Aucun étudiant à évaluer pour ces filtres.
      </div>
    {% endfor %}
  </div>
</div>
{% endblock %}
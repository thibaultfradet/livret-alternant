{% extends 'base.html.twig' %}

{% block title %}Sélection d'un alternant{% endblock %}

{% block body %}
<div class="page-body d-flex">
  <div class="container py-6 d-flex flex-column gap-4">
    <h1 class="fw-bold text-primary mb-5 display-5 text-center">
      Évaluez un alternant
    </h1>

    {% if not hasPeriods %}
      <div class="alert alert-warning d-flex align-items-center" role="alert">
        <i class="ti ti-alert-triangle me-2 fs-4"></i>
        <div>
          Aucune période n'a été trouvée pour l'année scolaire active.
          Les évaluations ne sont pas disponibles tant qu'aucune période n'est créée.
        </div>
      </div>
    {% endif %}

    <form method="get" onchange="this.submit()" class="mb-4">
      <div class="card shadow-sm p-3">
        <div class="row g-3 align-items-center">
          <div class="col-md-6">
            <label for="diploma" class="form-label fw-semibold mb-0">Diplôme</label>
            <select name="diploma" id="diploma" class="form-select">
              <option value="">-- Tous --</option>
              {% for id, label in diplomas %}
                <option value="{{ id }}" {% if selectedDiploma == id %}selected{% endif %}>{{ label }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="col-md-6">
            <label for="period" class="form-label fw-semibold mb-0">Période</label>
            <select name="period" id="period" class="form-select">
              {% for p in allPeriods %}
                <option value="{{ p.id }}" {% if period and period.id == p.id %}selected{% endif %}>
                  Période {{ p.periodNumber }} ({{ p.startDate|date('d/m/Y') }} - {{ p.endDate|date('d/m/Y') }})
                </option>
              {% endfor %}
            </select>
          </div>
        </div>
      </div>
    </form>

    {% for student in students %}
      {% set alreadyEvaluated = false %}
      {% if period %}
        {% for te in student.tutorEvaluationsReceived %}
          {% if te.period and te.period.id == period.id %}
            {% set alreadyEvaluated = true %}
          {% endif %}
        {% endfor %}
      {% endif %}

      <div class="card shadow-sm">
        <div class="card-body d-flex justify-content-between align-items-center">
          <p class="mb-0 fw-bold">{{ student.firstName }} {{ student.lastName }} - {{ student.classroom.diploma.label }}</p>
          <div class="d-flex gap-2">
            {% if not alreadyEvaluated %}
              {% if hasPeriods and period %}
                <a href="{{ path('app_create_evaluation', { 'student': student.id, 'period': period.id }) }}" class="btn btn-outline-primary">Evaluer</a>
              {% else %}
                <button class="btn btn-outline-primary" disabled>Evaluer</button>
              {% endif %}
            {% endif %}

            <a href="{{ path('app_student_evaluations', { 'student': student.id, 'period': period.id }) }}" class="btn btn-primary" target="_blank">
              Voir le livret
            </a>
          </div>
        </div>
      </div>
    {% else %}
      <div class="alert alert-info text-center">
        Aucun alternant à évaluer pour ces filtres.
      </div>
    {% endfor %}
  </div>
</div>
{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}Évaluation de l'alternant{% endblock %}

{% block body %}
<div class="page-body d-flex">
    <div class="container py-6 d-flex flex-column gap-4">

        {# --- PAGE TITLE --- #}
        <h1 class="fw-bold text-primary mb-5 display-5 text-center">
            Évaluation de l'alternant <b>{{ student.firstname }} {{ student.lastname }}</b>
        </h1>
        <h3 class="text-center mb-5">Période numéro {{ period.periodNumber }}</h3>

        {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': ''}}) }}

        {# --- COMPORTEMENT --- #}
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light">
                <h5 class="card-title mb-0">Comportement</h5>
            </div>

            <div class="card-body p-0 table-responsive">
                <table class="table table-bordered text-center mb-0 align-middle behavior-grid">
                    <tbody>
                        {% for behavior_entry in form.behaviorEvaluation %}
                            {% set selectedLevel = behavior_entry.behaviorLevel.vars.value %}
                            {% set sortedLevels = behavior_entry.vars.data.availableLevels|sort((a, b) => a.levelNumber <=> b.levelNumber) %}

                            <tr>
                                <td class="text-start fw-medium behavior-label-cell">
                                    {{ behavior_entry.vars.data.behaviorCriteria.label }}
                                </td>

                                {% for level in sortedLevels %}
                                    {% set isSelected =
                                        selectedLevel is not null
                                        and selectedLevel is not same as('')
                                        and selectedLevel.id == level.id
                                    %}

                                    <td class="p-0 behavior-td">
                                        <input
                                            type="radio"
                                            class="behavior-radio"
                                            name="{{ behavior_entry.behaviorLevel.vars.full_name }}"
                                            value="{{ level.id }}"
                                            {% if isSelected %}checked{% endif %}
                                        >

                                        <div
                                            class="behavior-cell {% if isSelected %}is-selected{% endif %}"
                                            data-level="{{ level.levelNumber }}"
                                            onclick="
                                                this.previousElementSibling.checked = true;
                                                this.closest('tr')
                                                    .querySelectorAll('.behavior-cell')
                                                    .forEach(c => c.classList.remove('is-selected'));
                                                this.classList.add('is-selected');
                                            "
                                        >
                                            {{ level.label }}
                                        </div>
                                    </td>
                                {% endfor %}
                            </tr>

                            {{ form_errors(behavior_entry.behaviorLevel) }}

                            <div class="d-none">
                                {{ form_widget(behavior_entry.behaviorCriteria) }}
                            </div>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {# --- GROUP SKILLS BY GROUP LABEL --- #}
        {% set grouped_skills = {} %}
        {% for skill_entry in form.skillEvaluation %}
            {% set groupLabel = skill_entry.vars.data.skillCriteria.skillGroup.label|default('Autres compétences') %}
            {% set grouped_skills = grouped_skills|merge({
                (groupLabel): (grouped_skills[groupLabel]|default([])|merge([skill_entry]))
            }) %}
        {% endfor %}

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light">
                <h5 class="card-title mb-0">Compétences</h5>
            </div>

            <div class="card-body">
                {% for groupLabel, skills in grouped_skills %}
                    {# --- SUB CARD PER GROUP --- #}
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white fw-semibold">
                            {{ groupLabel }}
                        </div>

                        <div class="card-body p-0 table-responsive">
                            <table
                                style="height: fit-content"
                                class="table table-bordered text-center mb-0 align-middle skill-grid"
                            >
                                <thead class="table-light">
                                    <tr>
                                        <th class="text-start">Compétence</th>
                                        {% for level in allSkillsLevels %}
                                            <th>{{ level.label }}</th>
                                        {% endfor %}
                                    </tr>
                                </thead>
                                <tbody>
                                  {% for skill_entry in skills %}
                                      {% set selectedLevel = skill_entry.skillLevel.vars.value %}

                                      <div class="d-none">
                                          {{ form_widget(skill_entry.skillCriteria) }}
                                      </div>

                                      <tr style="height: 100%">
                                          <td class="text-start fw-medium">
                                              {{ skill_entry.vars.data.skillCriteria.label }}
                                          </td>

                                          {% for level in allSkillsLevels %}
                                              {% set isSelected =
                                                  selectedLevel is not null
                                                  and selectedLevel is not same as('')
                                                  and selectedLevel.id == level.id
                                              %}

                                              <td class="p-0 skill-td">
                                                  <input
                                                      type="radio"
                                                      class="skill-radio"
                                                      name="{{ skill_entry.skillLevel.vars.full_name }}"
                                                      value="{{ level.id }}"
                                                      {% if isSelected %}checked{% endif %}
                                                  >

                                                  <div
                                                      class="skill-cell {% if isSelected %}is-selected{% endif %}"
                                                      style="--skill-color: {{ level.color }};"
                                                      onclick="
                                                          this.previousElementSibling.checked = true;
                                                          this.closest('tr')
                                                              .querySelectorAll('.skill-cell')
                                                              .forEach(c => c.classList.remove('is-selected'));
                                                          this.classList.add('is-selected');
                                                      "
                                                  >
                                                      &nbsp;
                                                  </div>
                                              </td>
                                          {% endfor %}
                                      </tr>
                                  {% endfor %}
                              </tbody>
                            </table>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

        {# --- REMARQUES ET COMMENTAIRES --- #}
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light">
                <h5 class="card-title mb-0">Remarques et commentaires</h5>
            </div>

            <div class="card-body">
                <div class="mb-3">
                    {{ form_row(form.strengths, {
                        'label': 'Points forts',
                        'attr': {'rows': 4, 'class': 'form-control'}
                    }) }}
                </div>

                <div class="mb-3">
                    {{ form_row(form.weaknesses, {
                        'label': 'Points faibles',
                        'attr': {'rows': 4, 'class': 'form-control'}
                    }) }}
                </div>

                <div class="mb-3">
                    {{ form_row(form.goals, {
                        'label': 'Objectifs à atteindre à la prochaine visite',
                        'attr': {'rows': 4, 'class': 'form-control'}
                    }) }}
                </div>

                <div class="mb-3">
                    {{ form_row(form.remarks, {
                        'label': 'Remarque du tuteur et attendus',
                        'attr': {'rows': 4, 'class': 'form-control'}
                    }) }}
                </div>
            </div>
        </div>

        {# --- BOUTON VALIDER --- #}
        <div class="d-flex justify-content-center mt-4">
            <button type="submit" id="submit-evaluation" class="btn btn-primary btn-lg px-5">
                {{ button_label|default('Valider mon évaluation') }}
            </button>
        </div>

        {# CSRF token seulement #}
        {{ form_widget(form._token) }}

        {{ form_end(form, {'render_rest': false}) }}

    </div>
</div>

{% endblock %}
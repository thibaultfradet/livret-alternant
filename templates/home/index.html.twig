{% extends 'base.html.twig' %}

{% block title %}Bienvenue sur le livret de l'alternant{% endblock %}

{% block body %}
<div class="container-fluid min-vh-100 d-flex flex-column justify-content-center align-items-center text-center p-4">

    <div>
        <h1 class="display-4 fw-bold mb-4">
            Bienvenue sur le livret de l'alternant
        </h1>

        <div class="logo-section mb-5">
            <img src="{{ asset('images/logo_bleu_zoom.png') }}" alt="Logo campus" class="img-fluid" style="max-width: 250px; max-height: 250px">
        </div>

        <div class="row justify-content-center g-4">

            <!-- Auto-évaluation -->
            <div class="col-lg-3 col-md-6">
                <a href="#" class="text-decoration-none text-dark d-block h-100">
                    <div class="card shadow-sm h-100 border-0">
                        <div class="card-body d-flex flex-column justify-content-center align-items-center p-4">
                            <div class="rounded-circle bg-beaupeyrat d-flex justify-content-center align-items-center mb-3" style="width: 70px; height: 70px;">
                                <!-- Clipboard Document Check SVG -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" width="36" height="36">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2l4-4m5 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                            </div>
                            <h5 class="card-title fw-bold">Auto-évaluation</h5>
                            <p class="card-text text-muted">M'évaluer sur une période</p>
                        </div>
                    </div>
                </a>
            </div>

            <!-- Mon livret -->
            <div class="col-lg-3 col-md-6">
                <a href="#" class="text-decoration-none text-dark d-block h-100">
                    <div class="card shadow-sm h-100 border-0">
                        <div class="card-body d-flex flex-column justify-content-center align-items-center p-4">
                            <div class="rounded-circle bg-beaupeyrat d-flex justify-content-center align-items-center mb-3" style="width: 70px; height: 70px;">
                                <!-- Document Check SVG -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" width="36" height="36">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2l4-4M12 20h9"/>
                                </svg>
                            </div>
                            <h5 class="card-title fw-bold">Mon livret</h5>
                            <p class="card-text text-muted">Accéder à mon livret</p>
                        </div>
                    </div>
                </a>
            </div>

            <!-- Équipe pédagogique -->
            <div class="col-lg-3 col-md-6">
                 <a href="#" class="text-decoration-none text-dark d-block h-100">
                    <div class="card shadow-sm h-100 border-0">
                        <div class="card-body d-flex flex-column justify-content-center align-items-center p-4">
                            <div class="rounded-circle bg-beaupeyrat d-flex justify-content-center align-items-center mb-3" style="width: 70px; height: 70px;">
                                <!-- Academic Cap SVG -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" width="36" height="36">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5zm0 0v6"/>
                                </svg>
                            </div>
                            <h5 class="card-title fw-bold">Équipe pédagogique</h5>
                            <p class="card-text text-muted">Voir la liste des membres</p>
                        </div>
                    </div>
                </a>
            </div>

        </div>
    </div>

</div>
{% endblock %}
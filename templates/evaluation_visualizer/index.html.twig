{% extends 'base.html.twig' %}

{% block title %}Visuel de validation des évaluations{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="mb-4">Visuel de validation des évaluations</h1>

    {% if error %}
        <div class="alert alert-danger">{{ error }}</div>
    {% endif %}

    {# FILTER FORM - TOP #}
    <form method="get" class="row g-3 mb-2 align-items-end">
        <div class="col-md-4">
            <label for="period" class="form-label">Période</label>
            <select name="period" id="period" class="form-select">
                {% for p in periods %}
                    <option value="{{ p.id }}" {% if selectedPeriod and p.id == selectedPeriod.id %}selected{% endif %}>
                        {{ p.periodNumber }} ({{ p.startDate|date('d/m/Y') }} - {{ p.endDate|date('d/m/Y') }})
                    </option>
                {% endfor %}
            </select>
        </div>

        <div class="col-md-4">
            <label for="classroom" class="form-label">Classe</label>
            <select name="classroom" id="classroom" class="form-select">
                <option value="" {% if not selectedClassroom %}selected{% endif %}>Toutes</option>
                {% for c in classrooms %}
                    <option value="{{ c.id }}" {% if selectedClassroom and c.id == selectedClassroom.id %}selected{% endif %}>
                        {{ c.id }} - {{ c.diploma.label }} ({{ c.schoolYear.label }})
                    </option>
                {% endfor %}
            </select>
        </div>

        <div class="col-md-4 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">Filtrer</button>
        </div>
    </form>

    {# BUTTONS BELOW FILTERS #}
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <a href="{{ path('notifier_pending_evaluations', { period: selectedPeriod ? selectedPeriod.id : null, classroom: selectedClassroom ? selectedClassroom.id : null }) }}" 
               class="btn btn-white text-dark border border-1 w-100">
                Notifier
            </a>
        </div>
        <div class="col-md-6">
            <a href="{{ path('export_evaluations', { period: selectedPeriod ? selectedPeriod.id : null, classroom: selectedClassroom ? selectedClassroom.id : null }) }}" 
               class="btn btn-success w-100">
                Export Excel
            </a>
        </div>
    </div>

    {# TABLE #}
    <div class="table-responsive">  
        <table class="table table-bordered table-striped text-center mt-2">
            <thead class="table-light">
                <tr>
                    <th>Alternant</th>
                    <th>Évaluation tuteur</th>
                    <th>Évaluation alternant</th>
                    <th>Évaluation de l'équipe pédagogique</th>
                    <th>Export PDF</th>
                </tr>
            </thead>
            <tbody>
                {% for eval in evaluations %}
                    <tr>
                        <td>
                            {{ eval.student.firstName }} {{ eval.student.lastName }}<br>
                            <small>{{ eval.classroom.diploma.label }} ({{ eval.classroom.schoolYear.label }})</small>
                        </td>
                        <td>
                            {% if eval.tutor_validated %}
                                <span class="text-success">&#10003;</span>
                            {% else %}
                                <span class="text-danger">&#10007;</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if eval.student_validated %}
                                <span class="text-success">&#10003;</span>
                            {% else %}
                                <span class="text-danger">&#10007;</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if eval.ttm_validated %}
                                <span class="text-success">&#10003;</span>
                            {% else %}
                                <span class="text-danger">&#10007;</span>
                            {% endif %}
                        </td>
                        <td>
                            <a href="/extraction/{{ eval.student.id }}" class="btn btn-danger btn-sm">PDF</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5">Aucune évaluation trouvée pour ces filtres.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
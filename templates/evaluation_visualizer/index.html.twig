{% extends 'base.html.twig' %}

{% block title %}Visuel de validation des évaluations{% endblock %}

{% block body %}
<div class="page-body d-flex">
  <div class="container py-6 d-flex flex-column gap-4">

    {# --- PAGE TITLE --- #}
    <h1 class="fw-bold text-primary text-center mb-5 display-5">
      Visuel de validation des évaluations
    </h1>

    {# --- ALERT MESSAGE --- #}
    {% if error %}
      <div class="alert alert-danger text-center">
        {{ error }}
      </div>
    {% endif %}

    {# --- FILTER FORM --- #}
    <div class="card">
      <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
          <div class="col-md-4">
            <label for="period" class="form-label fw-semibold">Période</label>
            <select name="period" id="period" class="form-select">
              {% for p in periods %}
                <option value="{{ p.id }}" {% if selectedPeriod and p.id == selectedPeriod.id %}selected{% endif %}>
                  {{ p.periodNumber }} ({{ p.startDate|date('d/m/Y') }} - {{ p.endDate|date('d/m/Y') }})
                </option>
              {% endfor %}
            </select>
          </div>

          <div class="col-md-4">
            <label for="classroom" class="form-label fw-semibold">Classe</label>
            <select name="classroom" id="classroom" class="form-select">
              <option value="" {% if not selectedClassroom %}selected{% endif %}>Toutes</option>
              {% for c in classrooms %}
                <option value="{{ c.id }}" {% if selectedClassroom and c.id == selectedClassroom.id %}selected{% endif %}>
                  {{ c.id }} - {{ c.diploma.label }} ({{ c.schoolYear.label }})
                </option>
              {% endfor %}
            </select>
          </div>

          <div class="col-md-4">
            <button type="submit" class="btn btn-primary w-100">
              <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-filter me-1" width="20" height="20" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M4 4h16v2l-6 7v5l-4 2v-7l-6-7z" />
              </svg>
              Filtrer
            </button>
          </div>
        </form>
      </div>
    </div>

    {# --- ACTION BUTTONS --- #}
    <div class="row g-3">
      <div class="col-md-6">
        <a href="{{ path('notifier_pending_evaluations', { period: selectedPeriod ? selectedPeriod.id : null, classroom: selectedClassroom ? selectedClassroom.id : null }) }}" 
           class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-bell me-2" width="20" height="20" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
            <path d="M10 5a2 2 0 1 1 4 0v1a7 7 0 0 1 5 6v3l1 1v1h-16v-1l1-1v-3a7 7 0 0 1 5-6v-1z" />
            <path d="M13.73 21a2 2 0 0 1-3.46 0" />
          </svg>
          Notifier
        </a>
      </div>
      <div class="col-md-6">
        <a href="{{ path('export_evaluations', { period: selectedPeriod ? selectedPeriod.id : null, classroom: selectedClassroom ? selectedClassroom.id : null }) }}" 
           class="btn btn-excel w-100 d-flex align-items-center justify-content-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-file-spreadsheet me-2" width="20" height="20" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
            <path d="M14 3v4a1 1 0 0 0 1 1h4" />
            <path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z" />
            <path d="M8 11h8v7h-8z" />
            <path d="M8 15h8" />
            <path d="M12 11v7" />
          </svg>
          Export Excel
        </a>
      </div>
    </div>

    {# --- TABLE --- #}
    <div class="card mt-4">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table id="evaluationsValidationTable" class="table table-vcenter card-table table-striped text-center mb-0">
            <thead class="table-light">
              <tr>
                <th>Alternant</th>
                <th>Évaluation tuteur</th>
                <th>Évaluation alternant</th>
                <th>Équipe pédagogique</th>
                <th>Export PDF</th>
              </tr>
            </thead>
            <tbody>
              {% for eval in evaluations %}
                <tr>
                  <td class="fw-semibold">
                    {{ eval.student.firstName }} {{ eval.student.lastName }}<br>
                    <small class="text-secondary">{{ eval.classroom.diploma.label }} ({{ eval.classroom.schoolYear.label }})</small>
                  </td>
                  <td>
                    {% if eval.tutor_validated %}
                      <span class="text-success">&#10003;</span>
                    {% else %}
                      <span class="text-danger">&#10007;</span>
                    {% endif %}
                  </td>
                  <td>
                    {% if eval.student_validated %}
                      <span class="text-success">&#10003;</span>
                    {% else %}
                      <span class="text-danger">&#10007;</span>
                    {% endif %}
                  </td>
                  <td>
                    {% if eval.ttm_validated %}
                      <span class="text-success">&#10003;</span>
                    {% else %}
                      <span class="text-danger">&#10007;</span>
                    {% endif %}
                  </td>
                  <td>
                    <a href="/extraction/{{ eval.student.id }}" class="btn btn-danger d-flex align-items-center justify-content-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-file-type-pdf me-2" width="24" height="24" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                            <path d="M14 3v4a1 1 0 0 0 1 1h4" />
                            <path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z" />
                            <path d="M12 17v-6" />
                            <path d="M9 17h3" />
                            <path d="M12 11h3" />
                        </svg>
                        PDF
                    </a>
                  </td>
                </tr>
              {% else %}
                <tr>
                  <td colspan="5" class="text-secondary py-4">Aucune évaluation trouvée pour ces filtres.</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </div>
</div>
{% endblock %}
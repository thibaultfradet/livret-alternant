{% extends 'base.html.twig' %}

{% block body %}
<div class="container mt-4">
    <h1 class="mb-4">Notifier les évaluations en attente</h1>

    {{ form_start(form) }}

    {% if selectedPeriod %}
        {{ form_row(form.periodId, { value: selectedPeriod.id }) }}
    {% endif %}

    <!-- Filters -->
    <div class="row mb-3">
        <div class="col-md-6">
            <input type="text" id="searchName" class="form-control" placeholder="Rechercher par nom...">
        </div>
        <div class="col-md-6">
            <input type="text" id="searchClass" class="form-control" placeholder="Rechercher par classe...">
        </div>
    </div>

    <div class="mb-3">
        <button type="submit" class="btn btn-success">Envoyer notifications</button>
        <button type="reset" class="btn btn-secondary">Annuler</button>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-striped text-center align-middle" id="evaluationTable">
            <thead class="table-light">
                <tr>
                    <th><input type="checkbox" id="selectAll" /></th>
                    <th>Alternant</th>
                    <th>Validation attendue</th>
                </tr>
            </thead>
            <tbody>
                {% for eval in evaluations %}
                    <tr>
                        <td>
                            {{ form_widget(form.selectedStudents[loop.index0]) }}
                        </td>
                        <td>
                            {{ eval.student.firstName }} {{ eval.student.lastName }}<br />
                            <small class="classroom-label">
                                {{ eval.classroom.diploma.label }} ({{ eval.classroom.schoolYear.label }})
                            </small>
                        </td>
                        <td>
                            {% if not eval.tutor_validated %}
                                <span class="badge bg-primary">Tuteur</span>
                            {% elseif not eval.student_validated %}
                                <span class="badge bg-warning text-dark">Alternant</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>  
    {{ form_end(form) }}
</div>

<script>
    // Select All functionality
    document.getElementById('selectAll')?.addEventListener('change', function(e) {
        document.querySelectorAll('input[name="notifier_evaluation[selectedStudents][]"]').forEach(cb => {
            cb.checked = e.target.checked;
        });
    });

    // Dynamic search filter
    function filterTable() {
        const nameFilter = document.getElementById('searchName').value.toLowerCase();
        const classFilter = document.getElementById('searchClass').value.toLowerCase();
        const rows = document.querySelectorAll('#evaluationTable tbody tr');

        rows.forEach(row => {
            const nameCell = row.cells[1]?.innerText.toLowerCase() || '';
            const classCell = row.querySelector('.classroom-label')?.innerText.toLowerCase() || '';

            if (nameCell.includes(nameFilter) && classCell.includes(classFilter)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    document.getElementById('searchName').addEventListener('input', filterTable);
    document.getElementById('searchClass').addEventListener('input', filterTable);
</script>
{% endblock %}

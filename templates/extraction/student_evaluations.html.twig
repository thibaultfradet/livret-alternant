{% extends 'base.html.twig' %}

{% block title %}Évaluations de l'étudiant{% endblock %}

{% block body %}
<div class="container py-5">

  {# --- Page title --- #}
  <h1 class="fw-bold text-primary mb-2 display-5 text-center">
    Évaluations de {{ student.firstName }} {{ student.lastName }}
  </h1>
  <p class="text-secondary text-center mb-5">
    {{ student.classroom.diploma.label }} ({{ student.classroom.schoolYear.label }})
  </p>

  {# --- Period filter dropdown and export button --- #}
  <div class="mb-4 text-center d-flex justify-content-center align-items-center gap-3">
    <form method="get" id="periodFilterForm" class="d-inline-flex align-items-center">
      <label for="period" class="fw-semibold me-2">Sélectionner la période :</label>
      <select id="period" name="period" class="form-select d-inline-block w-auto" onchange="document.getElementById('periodFilterForm').submit();">
        {% for period in periods %}
          <option value="{{ period.id }}" {% if selectedPeriod and period.id == selectedPeriod.id %}selected{% endif %}>
            Période {{ period.periodNumber }} ({{ period.startDate|date('d/m/Y') }} - {{ period.endDate|date('d/m/Y') }})
          </option>
        {% endfor %}
      </select>
    </form>

    {% if selectedPeriod %}
      <a href="{{ path('app_student_period_pdf', { student: student.id, period: selectedPeriod.id }) }}"
         class="btn btn-primary"
         target="_blank"
         title="Exporter cette période en PDF">
        <i class="bi bi-file-earmark-pdf me-1"></i> Exporter PDF
      </a>
    {% endif %}
  </div>

  {# --- Iterate over all periods --- #}
  {% for periodNumber, skillGroups in skillEvaluationsByPeriod|sort %}
    {% set period = periods|filter(p => p.periodNumber == periodNumber)|first %}

    <div class="mb-5 pt-4">
      <h2 class="fw-bold text-primary mb-3" style="font-size:1.8rem;">
        Période {{ periodNumber }} 
        {% if period %} ({{ period.startDate|date('d/m/Y') }} - {{ period.endDate|date('d/m/Y') }}){% endif %}
      </h2>

      {# --- Behavior evaluations --- #}
      {% set tutorEvalsForPeriod = student.tutorEvaluationsReceived|filter(e => e.period == period) %}
      <div class="card mb-4">
        <div class="card-header fw-bold bg-light">Appréciation du comportement au travail</div>
        <div class="card-body p-0 table-responsive">
          <table class="table table-bordered mb-0 text-center align-middle behavior-view-grid">
            <tbody>
              {% if tutorEvalsForPeriod is empty %}
                <tr>
                  <td colspan="6" class="text-muted p-3">Aucune évaluation de comportement pour cette période</td>
                </tr>
              {% else %}
                {% for tutorEval in tutorEvalsForPeriod %}
                  {% for behaviorEval in tutorEval.behaviorEvaluation %}
                    {% set sortedLevels = behaviorEval.behaviorCriteria.behaviorLevels|filter(l => l.disabledAt is null)|sort((a, b) => a.levelNumber <=> b.levelNumber) %}
                    <tr>
                      <td class="text-start fw-medium behavior-label-cell">
                        {{ behaviorEval.behaviorCriteria.label }}
                      </td>
                      {% for level in sortedLevels %}
                        {% set isSelected = behaviorEval.behaviorLevel and behaviorEval.behaviorLevel.id == level.id %}
                        {% set levelColor = '' %}
                        {% if isSelected %}
                          {% if level.levelNumber == 1 %}
                            {% set levelColor = '#EF4444' %}
                          {% elseif level.levelNumber == 2 %}
                            {% set levelColor = '#ff8904' %}
                          {% elseif level.levelNumber == 3 %}
                            {% set levelColor = '#FACC15' %}
                          {% elseif level.levelNumber == 4 %}
                            {% set levelColor = '#84CC16' %}
                          {% elseif level.levelNumber == 5 %}
                            {% set levelColor = '#22C55E' %}
                          {% endif %}
                        {% endif %}
                        <td class="p-0 behavior-view-cell" style="{% if isSelected %}background-color: {{ levelColor }}; color: {% if level.levelNumber == 3 %}#000{% else %}#fff{% endif %}; font-weight: 700;{% endif %}">
                          <div class="d-flex align-items-center justify-content-center h-100 p-2" style="font-size: 0.85rem;">
                            {{ level.label }}
                          </div>
                        </td>
                      {% endfor %}
                    </tr>
                  {% endfor %}
                {% endfor %}
              {% endif %}
            </tbody>
          </table>
        </div>
      </div>

      {# --- Skill evaluation grid with proper padding for sub-cards --- #}
      {% if skillGroups is empty %}
        <p class="text-muted">Aucune évaluation de compétences pour cette période.</p>
      {% else %}
        <div class="card mb-4">
          <div class="card-header fw-bold bg-light">Évaluation des compétences</div>
          <div class="card-body p-3"> {# <-- padding autour des sous-cards #}
            {% for groupId, groupData in skillGroups %}
              <div class="mb-3"> {# <-- marge entre chaque sous-card #}
                <div class="card shadow-sm">
                  <div class="card-header bg-white fw-semibold">
                    {{ groupData.label }}
                  </div>
                  <div class="card-body table-responsive p-0">
                    <table class="table table-bordered text-center mb-0 align-middle skill-grid">
                      <thead class="table-light">
                        <tr>
                          <th class="text-start">Compétence</th>
                          {% for level in allSkillsLevels %}
                            <th>{{ level.label }}</th>
                          {% endfor %}
                        </tr>
                      </thead>
                      <tbody>
                        {% for criteria in groupData.criteria %}
                          <tr>
                            <td class="text-start">{{ criteria.label }}</td>
                            {% for level in allSkillsLevels %}
                              {% set isSelected = criteria.level and criteria.level.id == level.id %}
                              <td style="background-color: {{ isSelected ? level.color : 'transparent' }};">
                                {% if isSelected %}&#10003;{% endif %}
                              </td>
                            {% endfor %}
                          </tr>
                        {% endfor %}
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}

      {# --- Points forts / faibles / objectifs / remarques ---#}
      {% for tutorEval in tutorEvalsForPeriod %}
        <div class="card mb-4">
          <table class="table mb-0">
            <tbody>
              <tr>
                <td style="width:25%; font-weight:bold;">Points forts</td>
                <td>{{ tutorEval.strengths|default('') }}</td>
              </tr>
              <tr>
                <td style="width:25%; font-weight:bold;">Points faibles</td>
                <td>{{ tutorEval.weaknesses|default('') }}</td>
              </tr>
              <tr>
                <td style="width:25%; font-weight:bold;">Objectifs</td>
                <td>{{ tutorEval.goals|default('') }}</td>
              </tr>
              <tr>
                <td style="width:25%; font-weight:bold;">Remarques du tuteur</td>
                <td>{{ tutorEval.remarks|default('') }}</td>
              </tr>
            </tbody>
          </table>
        </div>
      {% endfor %}

      {# --- Remarques de l'étudiant ---#}
      {% for studentEval in student.studentEvaluations %}
        {% if studentEval.period == period %}
          <div class="card mb-4">
            <div class="card-header fw-bold">Remarque de l'alternant et attendus</div>
            <div class="card-body">{{ studentEval.remarks|default('Aucune remarque') }}</div>
          </div>
        {% endif %}
      {% endfor %}

      {# --- Remarques TTM ---#}
      {% for ttmEval in student.TtmEvaluationsReceived %}
        {% if ttmEval.period == period %}
          <div class="card mb-4">
            <div class="card-header fw-bold">Remarques de l'équipe pédagogique et attendus</div>
            <div class="card-body">{{ ttmEval.remarks|default('Aucune remarque') }}</div>
          </div>
        {% endif %}
      {% endfor %}

      {# --- Validation des données pour cette période ---#}
      <div class="validation-container d-flex gap-3 mb-5">
        <div class="validation-box border p-2 flex-fill text-center">
          <strong>Tuteur</strong><br>
          {% set tutorEvalDate = tutorEvalsForPeriod|first ? tutorEvalsForPeriod|first.validationDate : null %}
          {% if tutorEvalDate %}
            Évaluation réalisée le {{ tutorEvalDate|date('d/m/Y') }}
          {% else %}
            Pas encore évalué
          {% endif %}
        </div>

        <div class="border p-2 flex-fill text-center">
          <strong>Alternant</strong><br>
          {% set studentEval = student.studentEvaluations|filter(e => e.period == period)|first %}
          {% if studentEval %}
            Évaluation réalisée le {{ studentEval.validationDate|date('d/m/Y') }}
          {% else %}
            Pas encore évalué
          {% endif %}
        </div>

        <div class="border p-2 flex-fill text-center">
          <strong>Équipe pédagogique</strong><br>
          {% set ttmEval = student.TtmEvaluationsReceived|filter(e => e.period == period)|first %}
          {% if ttmEval %}
            Évaluation réalisée le {{ ttmEval.validationDate|date('d/m/Y') }}
          {% else %}
            Pas encore évalué
          {% endif %}
        </div>
      </div>

    </div>
  {% else %}
    <p class="text-muted">Aucune évaluation pour cet étudiant.</p>
  {% endfor %}

</div>
{% endblock %}
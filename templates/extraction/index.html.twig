{% extends 'pdf.html.twig' %}


{% block body %}

<div class="py-3">
    <h2 class="mb-3">I. Acteurs et informations générales</h2>

    {# student information #}
    <div class="bg-beaupeyrat text-white py-1 px-3 mb-2 text-center h4">
        <h6 class="mb-0 small">1. INFORMATIONS ALTERNANT</h6>
    </div>
    <div class="border border-beaupeyrat border-2 p-3 mb-2">
        <table style="width:100%; border-collapse:collapse;">
            <tr>
                <td style="width:25%; font-size:12px; color:#666;">Section :</td>
                <td style="width:75%; padding-bottom:6px;">
                    <input type="text" class="form-control form-control-sm field-input"
                           value="{{ student.classroom.diploma.label|default('') }}"
                           disabled>
                </td>
            </tr>
            <tr>
                <td style="width:25%; font-size:12px; color:#666;">Nom Prénom :</td>
                <td>
                    <input type="text" class="form-control form-control-sm field-input"
                        value="{{ (student.lastName ~ ' ' ~ student.firstName)|default('') }}"
                           disabled>
                </td>
            </tr>
            <tr>
                <td style="width:25%; font-size:12px; color:#666;">Email :</td>
                <td>
                    <input type="email" class="form-control form-control-sm field-input"
                           value="{{ student.email|default('') }}"
                           disabled>
                </td>
            </tr>
        </table>
    </div>

    {# tutor information #}
    {% set tutorContract = student.studentContracts|first %}
    {% set tutor = tutorContract ? tutorContract.tutor : null %}
    <div class="card shadow-sm border-3 border-beaupeyrat mb-3">
        <div class="card-header bg-beaupeyrat text-white py-1 text-center h4">
            <h6 class="mb-0 small">2. INFORMATIONS EMPLOYEUR</h6>
        </div>
        <div class="card-body py-2 px-3">
            <table style="width:100%; border-collapse:collapse;">
                 <tr>
                    <td style="width:25%; font-size:12px; color:#666; padding-bottom:6px;">Nom de l'entreprise :</td>
                    <td style="width:75%;">
                        <input type="text" class="form-control form-control-sm field-input"
                               value="{{ tutor.companyName|default('') }}"
                               disabled>
                    </td>
                </tr>
                <tr>
                    <td style="width:25%; font-size:12px; color:#666; padding-bottom:6px;">Adresse de l'entreprise :</td>
                    <td style="width:75%;">
                        <input type="text" class="form-control form-control-sm field-input"
                               value="{{ tutor.companyAddress|default('') }}"
                               disabled>
                    </td>
                </tr>
                <tr>
                    <td style="width:25%; font-size:12px; color:#666; padding-bottom:6px;">Nom du tuteur :</td>
                    <td style="width:75%;">
                        <input type="text" class="form-control form-control-sm field-input"
                               value="{{ tutor.lastName ~ ' ' ~ tutor.firstName |default('') }}"
                               disabled>
                    </td>
                </tr>
                <tr>
                    <td style="width:25%; font-size:12px; color:#666; padding-bottom:6px;">Adresse mail du tuteur :</td>
                    <td style="width:75%;">
                        <input type="text" class="form-control form-control-sm field-input"
                               value="{{ tutor.email |default('') }}"
                               disabled>
                    </td>
                </tr>
                <tr>
                    <td style="width:25%; font-size:12px; color:#666; padding-bottom:6px;">Dates du contrat :</td>
                    {% set contractDates = tutorContract ? tutorContract.dateDebutContract|date('d/m/Y') ~ ' - ' ~ tutorContract.dateFinContract|date('d/m/Y') : '' %}
                    <td style="width:75%;">
                        <input type="text" class="form-control form-control-sm field-input"
                               value="{{ contractDates }}"
                               disabled>
                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>


<div class="page-break"></div>

{# --- formation center --- #}
<div class="bg-beaupeyrat text-white py-1 px-3 mb-2 text-center h4">
    <h6 class="mb-0 small">3. LE CENTRE DE FORMATION</h6>
</div>
<div class="border border-beaupeyrat border-2 p-3 mb-2">
            <img class="w-100" src="{{ asset(formationCenterPath) }}" alt="Information du centre de formation" 
</div>

<div class="page-break"></div>



{# --- Teaching team --- #}
<div class="card shadow-sm border-3 border-beaupeyrat mb-3 h-100">
    <div class="card-header bg-beaupeyrat text-white py-1 text-center h4">
        <h6 class="mb-0 small">4. Équipe pédagogique</h6>
    </div>
    <div class="card-body p-0 d-flex flex-column">
        <img src="{{ asset(ttmPath) }}" alt="Liste des membres de l'équipe pédagogique" 
    </div>
</div>





<div class="page-break"></div>

{# --- Terms of service --- #}
<div>
    <div class="bg-beaupeyrat text-white py-1 px-3 mb-2 text-center h4">
        <h6 class="mb-0 small">5. MODALITÉS D'UTILISATION DU LIVRET</h6>

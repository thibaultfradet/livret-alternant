{% extends 'pdf.html.twig' %}

{% block title %}Acteurs et informations générales{% endblock %}

{% block body %}

<div class="py-3">
    <h2 class="mb-3">I. Acteurs et informations générales</h2>

    {# student information #}
    <div class="bg-beaupeyrat text-white py-1 px-3 mb-2">
        <h6 class="mb-0 small">1. INFORMATIONS ALTERNANT</h6>
    </div>
    <div class="border border-beaupeyrat border-2 p-3 mb-2">
        <table style="width:100%; border-collapse:collapse;">
            <tr>
                <td style="width:25%; font-size:12px; color:#666;">Section :</td>
                <td style="width:75%; padding-bottom:6px;">
                    <input type="text" class="form-control form-control-sm field-input"
                           value="{{ student.classroom.diploma.label|default('') }}"
                           disabled>
                </td>
            </tr>
            <tr>
                <td style="width:25%; font-size:12px; color:#666;">Nom Prénom :</td>
                <td>
                    <input type="text" class="form-control form-control-sm field-input"
                        value="{{ (student.lastName ~ ' ' ~ student.firstName)|default('') }}"
                           disabled>
                </td>
            </tr>
            <tr>
                <td style="width:25%; font-size:12px; color:#666;">Email :</td>
                <td>
                    <input type="email" class="form-control form-control-sm field-input"
                           value="{{ student.email|default('') }}"
                           disabled>
                </td>
            </tr>
        </table>
    </div>

    {# tutor information #}
    {% set tutorContract = student.studentContracts|first %}
    {% set tutor = tutorContract ? tutorContract.tutor : null %}
    <div class="card shadow-sm border-3 border-beaupeyrat mb-3">
        <div class="card-header bg-beaupeyrat text-white py-1">
            <h6 class="mb-0 small">2. INFORMATIONS EMPLOYEUR</h6>
        </div>
        <div class="card-body py-2 px-3">
            <table style="width:100%; border-collapse:collapse;">
                <tr>
                    <td style="width:25%; font-size:12px; color:#666; padding-bottom:6px;">Nom du tuteur :</td>
                    <td style="width:75%;">
                        <input type="text" class="form-control form-control-sm field-input"
                               value="{{ tutor.lastName ~ ' ' ~ tutor.firstName |default('') }}"
                               disabled>
                    </td>
                </tr>
                <tr>
                    <td style="width:25%; font-size:12px; color:#666; padding-bottom:6px;">Adresse :</td>
                    <td style="width:75%;">
                        <input type="text" class="form-control form-control-sm field-input"
                               value="{{ tutor.address|default('') }}"
                               disabled>
                    </td>
                </tr>
                <tr>
                    <td style="width:25%; font-size:12px; color:#666; padding-bottom:6px;">Dates du contrat :</td>
                    {% set contractDates = tutorContract ? tutorContract.dateDebutContract|date('d/m/Y') ~ ' - ' ~ tutorContract.dateFinContract|date('d/m/Y') : '' %}
                    <td style="width:75%;">
                        <input type="text" class="form-control form-control-sm field-input"
                               value="{{ contractDates }}"
                               disabled>
                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>


<div class="page-break"></div>

{# --- Centre de formation --- #}
<div class="bg-beaupeyrat text-white py-1 px-3 mb-2">
    <h6 class="mb-0 small">3. LE CENTRE DE FORMATION</h6>
</div>
<div class="border border-beaupeyrat border-2 p-3 mb-2">
    <p>{{ student.classroom.schoolYear.label|default('') }}</p>
</div>

<div class="page-break"></div>

{# --- Equipe pédagogique (TTM) --- #}
<div class="card shadow-sm border-3 border-beaupeyrat mb-3">
    <div class="card-header bg-beaupeyrat text-white py-1">
        <h6 class="mb-0 small">4. Équipe pédagogique</h6>
    </div>
    <div class="card-body py-2 px-3">
        <table class="table" style="border-collapse: collapse; width: 100%;">
            <thead>
                <tr>
                    <th class="text-center" style="border: 1px solid #000; padding: 4px;">Nom Prénom</th>
                    <th class="text-center" style="border: 1px solid #000; padding: 4px;">Rôles</th>
                </tr>
            </thead>
            <tbody>
                {% for ttm in ttmRoles %}
                    <tr>
                        <td class="text-center" style="border: 1px solid #000; padding: 4px;">{{ ttm.name }}</td>
                        <td class="text-center" style="border: 1px solid #000; padding: 4px;">
                            {% for role in ttm.roles %}
                                • {{ role }}<br>
                            {% endfor %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="2" style="border: 1px solid #000; padding: 4px;">Aucun TTM trouvé.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>


<div class="page-break"></div>

{# --- Modalités d'utilisation du livret --- #}
<div>
    <div class="bg-beaupeyrat text-white py-1 px-3 mb-2">
        <h6 class="mb-0 small">5. MODALITÉS D'UTILISATION DU LIVRET</h6>
    </div>
    <table class="table table-bordered">
    <thead>
        <tr class="bg-beaupeyrat text-white">
            <th style="visibility: hidden;"></th>
            <th>L'alternant</th>
            <th>Le tuteur</th>
        </tr>
    </thead>
    <tbody>
        {% set studentAcceptance = student.termsAcceptances|first %}
        {% set tutorContract = student.studentContracts|first %}
        {% set tutor = tutorContract ? tutorContract.tutor : null %}
        {% set tutorAcceptance = tutor ? tutor.termsAcceptances|first : null %}

        <tr>
            <td class="bg-beaupeyrat text-white border-1">Date</td>
            <td class="border-1">
                {{ studentAcceptance ? studentAcceptance.validationDate|date('d/m/Y') : '' }}
            </td>
            <td class="border-1">
                {{ tutorAcceptance ? tutorAcceptance.validationDate|date('d/m/Y') : '' }}
            </td>
        </tr>
    </tbody>
    </table>
</div>

<div class="page-break"></div>

{# --- Informations pédagogiques / Calendrier --- #}
<div>
    <h2 class="mb-3">II. Informations pédagogiques</h2>
    <img src="/uploads/classroom/calendar-1.png" style="width:100%;">
</div>

<div class="page-break"></div>
{# --- Évaluations par période --- #}
<div>
    {% for period in student.classroom.schoolYear.periods %}
        <h3>Période {{ period.periodNumber }}</h3>

{% for eval in student.tutorEvaluationsReceived %}
            {% if eval.period == period %}
                <p><strong>Évaluation du tuteur :</strong> {{ eval.contents|json_encode }}</p>
            {% endif %}
        {% endfor %}

        {% for eval in student.TtmEvaluationsReceived %}
            {% if eval.period == period %}
                <p><strong>Évaluation TTM :</strong> {{ eval.contents|json_encode }}</p>
            {% endif %}
        {% endfor %}

        {% for eval in student.studentEvaluations %}
            {% if eval.period == period %}
                <p><strong>Auto-évaluation de l'alternant :</strong> {{ eval.contents|json_encode }}</p>
            {% endif %}
        {% endfor %}
    {% endfor %}
</div>


{% endblock %}

{% extends 'pdf.html.twig' %}

{% block body %}

{% if coverPagePath %}
<div class="cover-page">
    <img src="{{ asset(coverPagePath) }}" alt="Page de couverture">
</div>
<div class="page-break"></div>
{% endif %}

<div style="padding:20px; font-family:Arial, sans-serif; font-size:12px; color:#333;">

    <h2 style="margin-bottom:15px;">I. Acteurs et informations générales</h2>

    {# --- Informations Alternant ---#}
    <div class="section-header bg-beaupeyrat">1. INFORMATIONS ALTERNANT</div>
    <div class="section-body border border-beaupeyrat">
        <table class="info-table">
            <tr>
                <td>Section :</td>
                <td><input type="text" class="field-input" value="{{ student.classroom.diploma.label|default('') }}" disabled></td>
            </tr>
            <tr>
                <td>Nom Prénom :</td>
                <td><input type="text" class="field-input" value="{{ (student.lastName ~ ' ' ~ student.firstName)|default('') }}" disabled></td>
            </tr>
            <tr>
                <td>Email :</td>
                <td><input type="email" class="field-input" value="{{ student.email|default('') }}" disabled></td>
            </tr>
        </table>
    </div>

    {# --- Informations Employeur ---#}
    {% set tutorContract = student.studentContracts|first %}
    {% set tutor = tutorContract ? tutorContract.tutor : null %}
    <div class="section-body" style="border:1px solid var(--common-blue-beaupeyrat); border-radius:4px; margin-top:10px;">
        <div class="section-header bg-beaupeyrat">2. INFORMATIONS EMPLOYEUR</div>
        <table class="info-table">
            <tr>
                <td>Nom de l'entreprise :</td>
                <td><input type="text" class="field-input" value="{{ tutor.companyName|default('') }}" disabled></td>
            </tr>
            <tr>
                <td>Adresse de l'entreprise :</td>
                <td><input type="text" class="field-input" value="{{ tutor.companyAddress|default('') }}" disabled></td>
            </tr>
            <tr>
                <td>Nom du tuteur :</td>
                <td><input type="text" class="field-input" value="{{ tutor.lastName ~ ' ' ~ tutor.firstName|default('') }}" disabled></td>
            </tr>
            <tr>
                <td>Email du tuteur :</td>
                <td><input type="text" class="field-input" value="{{ tutor.email|default('') }}" disabled></td>
            </tr>
            <tr>
                <td>Dates du contrat :</td>
                {% set contractDates = tutorContract ? tutorContract.dateDebutContract|date('d/m/Y') ~ ' - ' ~ tutorContract.dateFinContract|date('d/m/Y') : '' %}
                <td><input type="text" class="field-input" value="{{ contractDates }}" disabled></td>
            </tr>
        </table>
    </div>

    <div class="page-break"></div>

    {# --- Centre de formation ---#}
    <div class="section-header bg-beaupeyrat">3. LE CENTRE DE FORMATION</div>
    <div class="section-body border border-beaupeyrat">

        {# --- Informations générales du centre ---#}
        <div class="card">
            <div class="card-header">Informations générales</div>
            <table style="width:100%; border-collapse:collapse;">
                <tr>
                    <td style="width:30%; font-weight:bold; padding:6px; border:1px solid #ccc;">Informations générales</td>
                    <td style="padding:6px; border:1px solid #ccc;">
                        {{ formationCenter.generalInfo|default('') }}
                    </td>
                </tr>
            </table>
        </div>

        {# --- Directeur ---#}
        {% set director = formationCenter.director %}
        {% if director %}
        <div class="card">
            <div class="card-header">Directeur</div>
            <table style="width:100%; border-collapse:collapse;">
                <tr>
                    <td style="width:30%; font-weight:bold; padding:6px; border:1px solid #ccc;">Nom</td>
                    <td style="padding:6px; border:1px solid #ccc;">{{ director.lastName ~ ' ' ~ director.firstName|default('') }}</td>
                </tr>
                <tr>
                    <td style="width:30%; font-weight:bold; padding:6px; border:1px solid #ccc;">Email</td>
                    <td style="padding:6px; border:1px solid #ccc;">{{ director.email|default('') }}</td>
                </tr>
                <tr>
                    <td style="width:30%; font-weight:bold; padding:6px; border:1px solid #ccc;">Téléphone</td>
                    <td style="padding:6px; border:1px solid #ccc;">{{ director.phone|default('') }}</td>
                </tr>
            </table>
        </div>
        {% endif %}

        {# --- Directeur de campus ---#}
        {% set campusDirector = formationCenter.campusDirector %}
        {% if campusDirector %}
        <div class="card">
            <div class="card-header">Directeur de campus</div>
            <table style="width:100%; border-collapse:collapse;">
                <tr>
                    <td style="width:30%; font-weight:bold; padding:6px; border:1px solid #ccc;">Nom</td>
                    <td style="padding:6px; border:1px solid #ccc;">{{ campusDirector.lastName ~ ' ' ~ campusDirector.firstName|default('') }}</td>
                </tr>
                <tr>
                    <td style="width:30%; font-weight:bold; padding:6px; border:1px solid #ccc;">Email</td>
                    <td style="padding:6px; border:1px solid #ccc;">{{ campusDirector.email|default('') }}</td>
                </tr>
                <tr>
                    <td style="width:30%; font-weight:bold; padding:6px; border:1px solid #ccc;">Téléphone</td>
                    <td style="padding:6px; border:1px solid #ccc;">{{ campusDirector.phone|default('') }}</td>
                </tr>
            </table>
        </div>
        {% endif %}

        {# --- Responsable de l'alternance ---#}
        {% set alternanceManager = formationCenter.alternanceManager %}
        {% if alternanceManager %}
        <div class="card">
            <div class="card-header">Responsable de l'alternance</div>
            <table style="width:100%; border-collapse:collapse;">
                <tr>
                    <td style="width:30%; font-weight:bold; padding:6px; border:1px solid #ccc;">Nom</td>
                    <td style="padding:6px; border:1px solid #ccc;">{{ alternanceManager.lastName ~ ' ' ~ alternanceManager.firstName|default('') }}</td>
                </tr>
                <tr>
                    <td style="width:30%; font-weight:bold; padding:6px; border:1px solid #ccc;">Email</td>
                    <td style="padding:6px; border:1px solid #ccc;">{{ alternanceManager.email|default('') }}</td>
                </tr>
                <tr>
                    <td style="width:30%; font-weight:bold; padding:6px; border:1px solid #ccc;">Téléphone</td>
                    <td style="padding:6px; border:1px solid #ccc;">{{ alternanceManager.phone|default('') }}</td>
                </tr>
            </table>
        </div>
        {% endif %}

        {# --- Référent handicap ---#}
        {% set handicapReferent = formationCenter.handicapReferent %}
        {% if handicapReferent %}
        <div class="card">
            <div class="card-header">Référent handicap</div>
            <table style="width:100%; border-collapse:collapse;">
                <tr>
                    <td style="width:30%; font-weight:bold; padding:6px; border:1px solid #ccc;">Nom</td>
                    <td style="padding:6px; border:1px solid #ccc;">{{ handicapReferent.lastName ~ ' ' ~ handicapReferent.firstName|default('') }}</td>
                </tr>
                <tr>
                    <td style="width:30%; font-weight:bold; padding:6px; border:1px solid #ccc;">Email</td>
                    <td style="padding:6px; border:1px solid #ccc;">{{ handicapReferent.email|default('') }}</td>
                </tr>
                <tr>
                    <td style="width:30%; font-weight:bold; padding:6px; border:1px solid #ccc;">Téléphone</td>
                    <td style="padding:6px; border:1px solid #ccc;">{{ handicapReferent.phone|default('') }}</td>
                </tr>
            </table>
        </div>
        {% endif %}

    </div>

    <div class="page-break"></div>

    {# --- Équipe pédagogique ---#}
    <div class="section-body" style="border:1px solid var(--common-blue-beaupeyrat); border-radius:4px; margin-bottom:10px;">
        <div class="section-header bg-beaupeyrat">4. Équipe pédagogique</div>
        <img src="file://{{ ttmPath }}" style="width:100%;" alt="Equipe pédagogique">
    </div>

    <div class="page-break"></div>

    {# --- Modalités du livret ---#}
    <div>
        <div class="section-header bg-beaupeyrat">5. MODALITÉS D'UTILISATION DU LIVRET</div>
        <div class="section-body">
            {{ termsConditions|raw}}
        </div>

        {# --- Validation des données (tuteur / alternant / équipe pédagogique) ---#}
        <div class="validation-container">

            <div class="validation-box">
                <strong>Tuteur</strong><br>
                {% if acceptances.tutor %}
                    A validé les données le {{ acceptances.tutor|date('d/m/Y') }}
                {% else %}
                    N'a pas validé les données
                {% endif %}
            </div>

            <div class="validation-box">
                <strong>Alternant</strong><br>
                {% if acceptances.student %}
                    A validé les données le {{ acceptances.student|date('d/m/Y') }}
                {% else %}
                    N'a pas validé les données
                {% endif %}
            </div>

            <div class="validation-box">
                <strong>Équipe pédagogique</strong><br>
                {% if acceptances.principalTeacher %}
                    A validé les données le {{ acceptances.principalTeacher|date('d/m/Y') }}
                {% else %}
                    N'a pas validé les données
                {% endif %}
            </div>

        </div>
    </div>

    <div class="page-break"></div>

    {# --- Informations pédagogiques ---#}
    <h2>II. Informations pédagogiques</h2>
    <div class="section-header bg-beaupeyrat">Calendrier d'alternance</div>
    <img src="file://{{ calendarPath }}" style="width:100%;" alt="Calendrier">

    {# --- Suivi de la formation / évaluations ---#}
    <h2>III. Suivi de la formation</h2>

    {% for period in student.classroom.schoolYear.periods %}
        <h3>Période {{ period.periodNumber }} - Du {{ period.startDate|date('d/m/Y') }} au {{ period.endDate|date('d/m/Y') }}</h3>

        {# --- Évaluations du tuteur pour cette période ---#}
        {% set tutorEvalsForPeriod = student.tutorEvaluationsReceived|filter(e => e.period == period) %}

        {% if tutorEvalsForPeriod is empty %}
            <div style="padding:10px; background-color:#f8f9fa; color:#6c757d; border:1px solid #e9ecef; border-radius:4px; margin-bottom:10px; text-align:center;">
                Aucune évaluation enregistrée pour cette période.
            </div>
        {% else %}
            {% for tutorEval in tutorEvalsForPeriod %}
                {# --- Évaluation du comportement ---#}
                <div class="card">
                    <div class="card-header">APPRECIATION DU COMPORTEMENT AU TRAVAIL</div>
                    <table style="border-collapse:collapse; width:100%;">
                        {% for behaviorEval in tutorEval.behaviorEvaluation %}
                            <tr>
                                <td style="width:25%; font-size:12px; color:#666; padding:6px; border:1px solid #ccc;">
                                    {{ behaviorEval.behaviorCriteria.label }}
                                </td>
                                <td style="width:75%; padding:6px; border:1px solid #ccc;">
                                    <input type="text" class="field-input" value="{{ behaviorEval.behaviorLevel.label|default('') }}" disabled>
                                </td>
                            </tr>
                        {% endfor %}
                    </table>
                </div>

                {# --- Grille des compétences par critère ---#}
                <div class="card">
                    <div class="card-header">GRILLE DES COMPÉTENCES</div>

                    {% for periodNumber, skillGroups in skillEvaluationsByPeriod %}
                        {% if periodNumber == period.periodNumber %}
                            {% for groupId, groupData in skillGroups %}
                                <h4 style="margin:10px 0 5px 0;">{{ groupData.label }}</h4>
                                <table style="border-collapse:collapse; width:100%; margin-bottom:15px;">
                                    <thead>
                                        <tr>
                                            <th style="border:1px solid #ccc; padding:4px; width:30%;">Compétence</th>
                                            {% for level in allSkillsLevels %}
                                                <th style="border:1px solid #ccc; padding:4px; text-align:center;">
                                                    {{ level.label }}
                                                </th>
                                            {% endfor %}
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for criteria in groupData.criteria %}
                                            <tr>
                                                <td style="border:1px solid #ccc; padding:6px;">
                                                    {{ criteria.label }}
                                                </td>
                                                {% for level in allSkillsLevels %}
                                                    {% set isSelected = criteria.level and criteria.level.id == level.id %}
                                                    {% set cellColor = isSelected and level.color ? level.color : '#ffffff' %}
                                                    <td style="border:1px solid #ccc; padding:6px; text-align:center; background-color: {{ cellColor }};">
                                                        {% if isSelected %}
                                                        {% else %}
                                                            &nbsp;
                                                        {% endif %}
                                                    </td>
                                                {% endfor %}
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            {% endfor %}
                        {% endif %}
                    {% endfor %}
                </div>

                {# --- Points forts / faibles / objectifs / remarques ---#}
                <div class="card">
                    <table style="width:100%; border-collapse:collapse;">
                        <tbody>
                            <tr>
                                <td style="width:25%; font-weight:bold; padding:10px; border:1px solid #ccc;">Points forts</td>
                                <td style="padding:10px; border:1px solid #ccc;">{{ tutorEval.strengths|default('') }}</td>
                            </tr>
                            <tr>
                                <td style="width:25%; font-weight:bold; padding:10px; border:1px solid #ccc;">Points faibles</td>
                                <td style="padding:10px; border:1px solid #ccc;">{{ tutorEval.weaknesses|default('') }}</td>
                            </tr>
                            <tr>
                                <td style="width:25%; font-weight:bold; padding:10px; border:1px solid #ccc;">Objectifs à atteindre à la prochaine période</td>
                                <td style="padding:10px; border:1px solid #ccc;">{{ tutorEval.goals|default('') }}</td>
                            </tr>
                            <tr>
                                <td style="width:25%; font-weight:bold; padding:10px; border:1px solid #ccc;">Remarques et attendus du tuteur</td>
                                <td style="padding:10px; border:1px solid #ccc;">{{ tutorEval.remarks|default('') }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

            {% endfor %}

            {# --- Remarques de l'étudiant ---#}
            {% for studentEval in student.studentEvaluations %}
                {% if studentEval.period == period %}
                    <div class="remarks-card">
                        <div class="remarks-header">Remarque de l'alternant et attendus</div>
                        <div class="remarks-content">{{ studentEval.remarks }}</div>
                    </div>
                {% endif %}
            {% endfor %}

            {# --- Remarques TTM ---#}
            {% for ttmEval in student.TtmEvaluationsReceived %}
                {% if ttmEval.period == period %}
                   <div class="remarks-card">
                        <div class="remarks-header">Remarques de l'équipe pédagogique et attendus</div>
                        <div class="remarks-content">{{ ttmEval.remarks|default('Aucune remarque') }}</div>
                    </div>
                {% endif %}
            {% endfor %}

        {% endif %}

        {# --- Dates d'évaluation pour cette période ---#}
        <div class="validation-container" style="margin-top:10px; display:flex; gap:15px;">
            <div class="validation-box" style="border:1px solid #ccc; padding:8px; border-radius:4px; flex:1; text-align:center;">
                <strong>Tuteur</strong><br>
                {% set tutorEvalDate = tutorEvalsForPeriod|first ? tutorEvalsForPeriod|first.validationDate : null %}
                {% if tutorEvalDate %}
                    Évaluation réalisée le {{ tutorEvalDate|date('d/m/Y') }}
                {% else %}
                    Pas encore évalué
                {% endif %}
            </div>

            <div class="validation-box" style="border:1px solid #ccc; padding:8px; border-radius:4px; flex:1; text-align:center;">
                <strong>Alternant</strong><br>
                {% set studentEval = student.studentEvaluations|filter(e => e.period == period)|first %}
                {% if studentEval %}
                    Évaluation réalisée le {{ studentEval.validationDate|date('d/m/Y') }}
                {% else %}
                    Pas encore évalué
                {% endif %}
            </div>

            <div class="validation-box" style="border:1px solid #ccc; padding:8px; border-radius:4px; flex:1; text-align:center;">
                <strong>Équipe pédagogique</strong><br>
                {% set ttmEval = student.TtmEvaluationsReceived|filter(e => e.period == period)|first %}
                {% if ttmEval %}
                    Évaluation réalisée le {{ ttmEval.validationDate|date('d/m/Y') }}
                {% else %}
                    Pas encore évalué
                {% endif %}
            </div>
        </div>

        {% if not loop.last %}
            <div class="page-break"></div>
        {% endif %}
    {% endfor %}

</div>

{% endblock %}
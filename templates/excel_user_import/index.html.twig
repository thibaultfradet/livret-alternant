{% extends 'base.html.twig' %}

{% block title %}Importer des utilisateurs depuis Excel{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="fw-bold text-primary mb-5 display-5 text-center">Importer des utilisateurs depuis un fichier Excel</h1>

    <div class="alert alert-info d-flex align-items-center" role="alert">
        <i class="ti ti-info-circle me-2 fs-4"></i>
        <div>
            Année scolaire active : <strong>{{ activeSchoolYear.label }}</strong>
            ({{ activeSchoolYear.startDate|date('d/m/Y') }} - {{ activeSchoolYear.endDate|date('d/m/Y') }}).
            Les données importées seront rattachées à cette année scolaire.
        </div>
    </div>

    <div class="card">
        <div class="card-body">
           <form method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="excelFile" class="form-label">Fichier Excel</label>
                    <input type="file" name="excelFile" id="excelFile" class="form-control" required>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <a href="{{ path('training_parameters_user') }}" class="btn btn-outline-secondary">
                        <i class="ti ti-arrow-left me-1"></i>
                        Retour à la liste
                    </a>

                    <button type="submit" class="btn btn-primary">
                        <i class="ti ti-upload me-1"></i>
                        Importer les utilisateurs
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header">
            <h5 class="card-title mb-0">
                <i class="ti ti-certificate me-1"></i>
                Référence des codes diplômes
            </h5>
        </div>
        <div class="card-body">
            {% if diplomas is not empty %}
                <table class="table table-striped table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Libellé</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for diploma in diplomas %}
                            <tr>
                                <td><code>{{ diploma.code }}</code></td>
                                <td>{{ diploma.label }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <p class="text-muted mb-0">Aucun diplôme configuré pour votre établissement.</p>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

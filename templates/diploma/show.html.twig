{% extends 'base.html.twig' %}

{% block title %}Diplôme{% endblock %}

{% block body %}
<div class="page page-center">
    <div class="container">

        <div class="text-center mb-5">
            <h1 class="fw-bold text-primary display-5">
                Diplôme
            </h1>
            <p class="text-muted">
                Détail du diplôme sélectionné
            </p>
        </div>

        <div class="card shadow-sm">
            <div class="card-header">
                <h3 class="card-title mb-0">
                    {{ diploma.label }}
                </h3>
            </div>

            <div class="card-body">
                <div class="row g-4">
                    <div class="col-12">
                        <div class="datagrid">
                            <div class="datagrid-item">
                                <div class="datagrid-title">Titre</div>
                                <div class="datagrid-content">{{ diploma.label }}</div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Code</div>
                                <div class="datagrid-content">{{ diploma.code ?: '-' }}</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-footer d-flex justify-content-between">
                <a href="{{ path('training_parameters_diploma') }}" class="btn btn-outline-secondary">
                    ← Retour à la liste
                </a>

                <a href="{{ path('app_diploma_edit', {'id': diploma.id}) }}" class="btn btn-primary">
                    Modifier
                </a>
            </div>
        </div>

    </div>
</div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Détail du diplôme{% endblock %}

{% block body %}
<div class="container mt-5">

    <div class="text-center mb-4">
        <h1 class="fw-bold text-primary mb-5 display-5 text-center">Détail du diplôme</h1>
        <div class="d-flex justify-content-center gap-2">
            <a href="{{ path('app_diploma_index') }}" class="btn btn-outline-primary">
                <i class="ti ti-arrow-left"></i> Retour à la liste
            </a>
            <a href="{{ path('app_diploma_edit', {'id': diploma.id}) }}" class="btn btn-outline-primary">
                <i class="ti ti-edit"></i> Modifier
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-vcenter table-striped table-hover align-middle w-50 mx-auto">
                    <tbody>
                        <tr>
                            <th class="text-start w-25">ID</th>
                            <td>{{ diploma.id }}</td>
                        </tr>
                        <tr>
                            <th>Titre</th>
                            <td>{{ diploma.label }}</td>
                        </tr>
                        <tr>
                            <th>Code</th>
                            <td>{{ diploma.code }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}Gestion des titres{% endblock %}

{% block body %}
    <h1>Gestion des titres</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Label</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for diploma in diplomas %}
            <tr>
                <td>{{ diploma.id }}</td>
                <td>{{ diploma.label }}</td>
                <td>
                    <a href="{{ path('app_diploma_show', {'id': diploma.id}) }}">Voir</a>
                    <a href="{{ path('app_diploma_edit', {'id': diploma.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">Aucun dipôme trouvé.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_diploma_new') }}">Ajouter un diplôme</a>
{% endblock %}

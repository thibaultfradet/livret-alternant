{% extends 'base.html.twig' %}

{% block title %}Ajouter un diplôme{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="fw-bold text-primary mb-5 display-5 text-center">Ajouter un diplôme</h1>

    <div class="card p-4 mb-4">
        {{ form_start(form) }}
            {{ form_widget(form) }}

            <div class="d-flex justify-content-between mt-4">
                <a class="btn btn-outline-secondary" href="{{ path('training_parameters_diploma') }}">Retour à la liste</a>
                <button class="btn btn-primary">{{ button_label|default('Enregistrer') }}</button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}Modifier un diplôme{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="mb-4">Modifier un diplôme</h1>

    <div class="card p-4 mb-4">
        {{ include('diploma/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" href="{{ path('app_diploma_index') }}">Revenir à la liste</a>
        {{ include('diploma/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}Period{% endblock %}

{% block body %}
    <h1>Period</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ period.id }}</td>
            </tr>
            <tr>
                <th>PeriodNumber</th>
                <td>{{ period.periodNumber }}</td>
            </tr>
            <tr>
                <th>StartDate</th>
                <td>{{ period.startDate ? period.startDate|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>EndDate</th>
                <td>{{ period.endDate ? period.endDate|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>DisabledAt</th>
                <td>{{ period.disabledAt ? period.disabledAt|date('Y-m-d') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_period_index') }}">back to list</a>

    <a href="{{ path('app_period_edit', {'id': period.id}) }}">edit</a>

    {{ include('period/_delete_form.html.twig') }}
{% endblock %}

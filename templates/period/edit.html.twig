{% extends 'base.html.twig' %}

{% block title %}Modifier une période{% endblock %}

{% block body %}
<div class="container mt-5">

    <h1 class="fw-bold text-primary mb-5 display-5 text-center">Modifier une période</h1>

    <div class="card shadow-sm border-0 rounded-3 p-4 mb-3">
        {{ include('period/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
    </div>

    <div class="mt-3">
        <a href="{{ path('app_period_index') }}" class="btn btn-outline-primary">
            Retour à la liste
        </a>
        {{ include('period/_delete_form.html.twig', { 'button_label': 'Supprimer la période' }) }}
    </div>

</div>
{% endblock %}
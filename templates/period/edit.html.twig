{% extends 'base.html.twig' %}

{% block title %}Modifier une période{% endblock %}

{% block body %}
<div class="container mt-5">

    <h1 class="fw-bold text-primary mb-5 display-5 text-center">Modifier une période</h1>

    <div class="card shadow-sm border-0 rounded-3 p-4 mb-3">
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <button class="btn btn-primary">{{ button_label|default('Mettre à jour') }}</button>
        {{ form_end(form) }}
    </div>

    <div class="mt-3">
        <a href="{{ path('training_parameters_period') }}" class="btn btn-outline-secondary">
            Retour à la liste
        </a>
    </div>

</div>
{% endblock %}
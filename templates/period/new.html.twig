{% extends 'base.html.twig' %}

{% block title %}Nouvelle période{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h1 class="fw-bold text-primary mb-5 display-5 text-center">Créer une nouvelle période</h1>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            {{ include('period/_form.html.twig', {'button_label': 'Créer'}) }}
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-12 text-center">
            <a href="{{ path('app_period_index') }}" class="btn btn-outline-primary">
                Retour à la liste
            </a>
        </div>
    </div>
</div>
{% endblock %}
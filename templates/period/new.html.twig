{% extends 'base.html.twig' %}

{% block title %}Nouvelle période{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h1 class="fw-bold text-primary mb-5 display-5 text-center">Créer une nouvelle période</h1>
        </div>
    </div>

     <div class="card shadow-sm border-0 rounded-3 p-4 mb-3">
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <button class="btn btn-primary">{{ button_label|default('Enregistrer') }}</button>
        {{ form_end(form) }}
    </div>

    <div class="row mt-3">
        <div class="col-12 text-center">
            <a href="{{ path('app_period_index') }}" class="btn btn-outline-primary">
                Retour à la liste
            </a>
        </div>
    </div>
</div>
{% endblock %}
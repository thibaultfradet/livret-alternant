{% extends 'base.html.twig' %}

{% block title %}Nouvelle période{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h1 class="fw-bold text-primary mb-5 display-5 text-center">
                Créer une nouvelle période
            </h1>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-3 p-4 mb-3">
        {{ form_start(form) }}

        {# Period number + school year on the same line #}
        <div class="row mb-3">
            <div class="col-md-4">
                {{ form_row(form.periodNumber) }}
            </div>
            <div class="col-md-8">
                {{ form_row(form.schoolYear) }}
            </div>
        </div>

        {# Start date + end date on the same line #}
        <div class="row mb-3">
            <div class="col-md-6">
                {{ form_row(form.startDate) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.endDate) }}
            </div>
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a href="{{ path('training_parameters_period') }}" class="btn btn-outline-secondary">
                Retour à la liste
            </a>
            <button class="btn btn-primary">
                {{ button_label|default('Enregistrer') }}
            </button>
        </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
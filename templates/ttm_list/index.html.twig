{% extends 'base.html.twig' %}

{% block title %}Liste de l'équipe pédagogique{% endblock %}

{% block body %}
<div class="container min-vh-100 d-flex flex-column justify-content-center align-items-center py-5">
    <h1 class="text-center my-3">Liste de l'équipe pédagogique</h1>
    <div class="card shadow-lg w-100" style="max-width: 900px;">
        
        <div class="card-body p-3">
            <table class="table table-striped table-hover text-center align-middle">
                <thead style="background-color: #e9ecef;">
                    <tr>
                        <th>Formateur</th>
                        <th>Discipline</th>
                    </tr>
                </thead>
                <tbody>
                    {% for ttm in ttmRoles %}
                        <tr>
                            <td>{{ ttm.name }}</td>
                            <td>
                                <ul class="list-unstyled mb-0">
                                    {% for role in ttm.roles %}
                                        <li>• {{ role }}</li>
                                    {% endfor %}
                                </ul>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="2">Aucun TTM trouvé.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

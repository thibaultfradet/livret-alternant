{% extends 'base.html.twig' %}

{% block title %}Modifier les conditions de la classe{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h1 class="fw-bold text-primary mb-5 display-5 text-center">
                Modifier les conditions de la classe {{ classroom.diploma.label }}
            </h1>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            {{ form_start(form) }}

            {# Terms for professional context #}
            <div class="mb-3">
                {{ form_row(form.termsConditionsPro, {'attr': {'class': 'summernote'}}) }} 
            </div>

            {# Terms for alternance context #}
            <div class="mb-3">
                {{ form_row(form.termsConditionsAlternance, {'attr': {'class': 'summernote'}}) }}
            </div>

            <div class="d-flex justify-content-between my-4">
                <a href="{{ path('training_parameters_classroom') }}" class="btn btn-outline-secondary">
                    Retour à la liste
                </a>
                <button class="btn btn-primary">
                    Enregistrer
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}


{% block javascripts %}
    {{ parent() }}

    <link href="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            $('.summernote').summernote({
                height: 200,
                placeholder: 'Entrez les conditions générales...',
            });
        });
    </script>
{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}Liste des classes{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="fw-bold text-primary mb-5 display-5 text-center">Classes de l'année {{ activeYear ? activeYear.label : 'inconnue' }}</h1>

    <div class="mb-4 d-flex justify-content-end">
        <a href="{{ path('app_classroom_new') }}"
            class="btn btn-primary ">
            Créer une nouvelle classe
        </a>
    </div>

    {% if classrooms is not empty %}
        <table id="classroomTable" class="table table-striped align-middle">            
            <thead>
                <tr>
                    <th scope="col">Diplôme</th>
                    <th scope="col">Professeur référent</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for classroom in classrooms %}
                    <tr>
                        <td>{{ classroom.diploma.label }}</td>
                        <td>
                            {% if classroom.principalTeacher %}
                                {{ classroom.principalTeacher.lastName }} {{ classroom.principalTeacher.firstName }}
                            {% else %}
                                N/A
                            {% endif %}
                        </td>
                        <td class="text-end">
                            <a href="{{ path('app_classroom_files', {'id': classroom.id}) }}" 
                               class="btn btn-outline-primary ">
                                Modifier les fichiers
                            </a>
                            
                            <a href="{{ path('app_classroom_tp', {'id': classroom.id}) }}" 
                               class="btn btn-outline-primary ">
                                Modifier le professeur référent
                            </a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p>Aucune classe disponible pour l'année scolaire active.</p>
    {% endif %}
</div>
{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}Modifier le référent de formation{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="mb-4">
        Référent de formation – {{ classroom.diploma.label }}
    </h1>

    {{ form_start(form) }}
        {{ form_row(form.trainingContactName) }}
        {{ form_row(form.trainingContactPhone) }}

        <div class="mt-3">
            <button class="btn btn-primary">
                Enregistrer
            </button>

            <a href="{{ path('app_classroom_index') }}"
               class="btn btn-secondary ms-2">
                Annuler
            </a>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
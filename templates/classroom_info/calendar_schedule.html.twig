{% extends 'base.html.twig' %}

{% block title %}Calendrier et emploi du temps{% endblock %}

{% block body %}
{% if hasData %}
    <div class="container min-vh-100 d-flex flex-column justify-content-center align-items-center py-5">
        <div class="card shadow-lg w-100">
            <div class="card-body">

                {% if calendarFile %}
                    <h1 class="fw-bold text-primary mb-4 text-center">Calendrier</h1>
                    <img src="{{ asset(calendarFile) }}" class="img-fluid rounded mb-5">
                {% endif %}

                {% if scheduleFile %}
                    <h1 class="fw-bold text-primary mb-4 text-center">Emploi du temps</h1>
                    <img src="{{ asset(scheduleFile) }}" class="img-fluid rounded">
                {% endif %}

            </div>
        </div>
    </div>
{% else %}
    <div class="container text-center py-5">
        <p class="text-muted fst-italic">
            Aucun calendrier ou emploi du temps disponible pour le moment.
        </p>
    </div>
{% endif %}
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Gestion des comportements{% endblock %}

{% block body %}
<div class="page-body d-flex">
  <div class="container py-6 d-flex flex-column gap-4">

    <h1 class="fw-bold text-primary text-center display-5 mb-4">
      Gestion des critères et niveaux de comportement
    </h1>

    <div class="d-flex justify-content-end">
      <a href="{{ path('app_behavior_manage_create') }}" class="btn btn-primary">
        Ajouter comportement
      </a>
    </div>

    <div class="card shadow-sm">
      <div class="table-responsive">
        <table id="behaviorTable" class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Libellé</th>
              <th>Niveau 1</th>
              <th>Niveau 2</th>
              <th>Niveau 3</th>
              <th>Niveau 4</th>
              <th>Niveau 5</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            {% for behavior in behaviors %}
              <tr>
                <td><strong>{{ behavior.label }}</strong></td>

                {% set levels = {} %}
                {% for level in behavior.behaviorLevels %}
                  {% if level.disabledAt is null %}
                    {% set levels = levels|merge({ (level.levelNumber): {'id': level.id, 'label': level.label} }) %}
                  {% endif %}
                {% endfor %}

                {% for i in 0..4 %}
                  <td>
                    {{ levels[i] is defined ? levels[i].label : '-' }}

                    {# Lien vers page dédiée pour remplacer le niveau avec icône SVG #}
                    {% if levels[i] is defined %}
                      <a
                        href="{{ path('app_behavior_level_replace', { id: levels[i].id }) }}"
                        class="text-danger ms-2"
                        title="Remplacer ce niveau"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 14 14">
                          <g fill="none" stroke="#888888" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m7.5 9l-3 .54L5 6.5L10.73.79a1 1 0 0 1 1.42 0l1.06 1.06a1 1 0 0 1 0 1.42Z"/>
                            <path d="M12 9.5v3a1 1 0 0 1-1 1H1.5a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1h3"/>
                          </g>
                        </svg>
                      </a>
                    {% endif %}
                  </td>
                {% endfor %}

                
                {# Actions sur le critère #}
                <td class="text-end">
                  {% if behavior.disabledAt is null %}
                    <a
                      href="{{ path('app_behavior_disable', { id: behavior.id }) }}"
                      class="text-danger"
                      onclick="return confirm('Êtes-vous sûr de vouloir désactiver ce comportement ? Cette action est irréversible !');"
                      title="Désactiver ce comportement"
                    >
                      Désactiver
                    </a>
                  {% else %}
                    <span class="text-muted">Désactivé</span>
                  {% endif %}
                </td>

              </tr>
            {% else %}
              <tr>
                <td colspan="7" class="text-center text-muted">Aucun critère de comportement trouvé.</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</div>
{% endblock %}
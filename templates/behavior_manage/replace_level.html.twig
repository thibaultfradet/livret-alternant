{% extends 'base.html.twig' %}

{% block title %}Remplacement d'un niveau{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <h1 class="mb-4 text-center">Remplacement d'un niveau</h1>

            <div class="bg-light p-4 rounded shadow-sm">

                {# Ancien niveau #}
                <div class="mb-3">
                    <label class="form-label fw-bold">Ancien niveau :</label>
                    <p class="text-info fw-bold">{{ level.label }}</p>
                </div>

                {# Nouveau niveau avec FormType #}
                {{ form_start(form) }}
                    {{ form_row(form.label_level_replacement) }}

                    <div class="d-flex justify-content-between mt-4">
                        <a href="{{ path('training_parameters_behavior') }}" class="btn btn-light border">Annuler</a>
                        <button type="submit" class="btn btn-danger">Valider</button>
                    </div>
                {{ form_end(form) }}

            </div>

        </div>
    </div>
</div>
{% endblock %}
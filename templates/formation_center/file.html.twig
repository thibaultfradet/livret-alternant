{% extends 'base.html.twig' %}

{% block title %}Fichier du centre de formation{% endblock %}

{% block body %}
<div class="container mt-4">
    <h2>Mise en ligne du fichier du centre de formation sur l'année {{activeYear.label}}</h2>

    {{ form_start(form) }}
        {{ form_row(form.formation_center_file) }}
        <button class="btn btn-primary mt-2">Mettre à jour</button>
    {{ form_end(form) }}

    {% if filePath %}
        <hr>
        <h4>Fichier actuel :</h4>
        <img src="{{ filePath }}" alt="Fichier du centre" style="max-width:400px;">
    {% endif %}
</div>
{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}Modifier une année scolaire{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h1 class="fw-bold text-primary mb-5 display-5 text-center">Modifier une année scolaire</h1>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            {{ include('school_year/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
        </div>
    </div>

    <div class="row mt-3 justify-content-center">
        <div class="col-auto">
            <a href="{{ path('app_school_year_index') }}" class="btn btn-outline-primary">
                Retourner à la liste
            </a>
        </div>
        <div class="col-auto">
            {{ include('school_year/_delete_form.html.twig') }}
        </div>
    </div>
</div>
{% endblock %}
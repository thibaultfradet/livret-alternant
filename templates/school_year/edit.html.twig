{% extends 'base.html.twig' %}

{% block title %}Modifier une année scolaire{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h1 class="fw-bold text-primary mb-5 display-5 text-center">Modifier une année scolaire</h1>
        </div>
    </div>

     <div class="row justify-content-center">
        <div class="col-lg-8">
            {{ form_start(form) }}
                {{ form_widget(form) }}
                <div class="d-flex justify-content-between my-4">
                    <a href="{{ path('app_school_year_index') }}" class="btn btn-outline-primary">
                        Retourner à la liste
                    </a>
                    <button class="btn btn-primary">{{ button_label|default('Enregistrer') }}</button>
                </div>
            {{ form_end(form) }}
            
        </div>
    </div>
</div>
{% endblock %}
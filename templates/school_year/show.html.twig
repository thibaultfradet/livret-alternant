{% extends 'base.html.twig' %}

{% block title %}Année scolaire{% endblock %}

{% block body %}
    <h1>Année scolaire</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ school_year.id }}</td>
            </tr>
            <tr>
                <th>Libellé</th>
                <td>{{ school_year.label }}</td>
            </tr>
            <tr>
                <th>Date de début</th>
                <td>{{ school_year.startDate ? school_year.startDate|date('d/m/Y') : '' }}</td>
            </tr>
            <tr>
                <th>Date de fin</th>
                <td>{{ school_year.endDate ? school_year.endDate|date('d/m/Y') : '' }}</td>
            </tr>
            <tr>
                <th>Active</th>
                <td>{{ school_year.active ? 'Oui' : 'Non' }}</td>
            </tr>
            <tr>
                <th>Conditions du livret sur l'année</th>
                <td>{{ school_year.termsContent }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_school_year_index') }}">Retourner à la liste</a>

    <a href="{{ path('app_school_year_edit', {'id': school_year.id}) }}">Modifier</a>

    {{ include('school_year/_delete_form.html.twig') }}
{% endblock %}

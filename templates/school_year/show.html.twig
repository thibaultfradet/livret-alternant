{% extends 'base.html.twig' %}

{% block title %}Année scolaire{% endblock %}

{% block body %}
<div class="page page-center">
    <div class="container container-narrow py-6">

        <div class="text-center mb-5">
            <h1 class="fw-bold text-primary display-5">
                Année scolaire
            </h1>
            <p class="text-muted">
                Détail de l’année scolaire sélectionnée
            </p>
        </div>

        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title mb-0">
                    {{ school_year.label }}
                </h3>

                {% if school_year.active %}
                    <span class="badge text-white bg-success text-white">
                        Active
                    </span>
                {% else %}
                    <span class="badge text-white bg-secondary text-white">
                        Inactive
                    </span>
                {% endif %}
            </div>

            <div class="card-body">
                <div class="row g-4">

                    <div class="col-12">
                        <div class="datagrid">
                            <div class="datagrid-item">
                                <div class="datagrid-title">Période</div>
                                <div class="datagrid-content">
                                    {{ school_year.startDate ? school_year.startDate|date('d/m/Y') : '-' }}
                                    <span class="text-muted mx-1">→</span>
                                    {{ school_year.endDate ? school_year.endDate|date('d/m/Y') : '-' }}
                                </div>
                            </div>
                        </div>
                    </div>

                    {% if school_year.termsContent %}
                        <div class="col-12">
                            <div class="card mt-3">
                                <div class="card-header">
                                    <h4 class="card-title mb-0">
                                        Conditions du livret sur l’année
                                    </h4>
                                </div>
                                <div class="card-body">
                                    <div class="text-muted">
                                        {{ school_year.termsContent|raw }}
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>

            <div class="card-footer d-flex justify-content-between">
                <a href="{{ path('app_school_year_index') }}" class="btn btn-outline-secondary">
                    ← Retour à la liste
                </a>

                <a href="{{ path('app_school_year_edit', {'id': school_year.id}) }}" class="btn btn-primary">
                    Modifier
                </a>
            </div>
        </div>

    </div>
</div>
{% endblock %}
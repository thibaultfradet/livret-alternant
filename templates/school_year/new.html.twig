{% extends 'base.html.twig' %}

{% block title %}Ajouter une année scolaire{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h1 class="fw-bold text-primary mb-5 display-5 text-center">
                Ajouter une année scolaire
            </h1>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card p-4">
                <div class="alert alert-info">
                    <strong>Information :</strong> L'activation d'une nouvelle année scolaire entraînera une demande de validation des conditions d'utilisation liées à celle-ci pour tous les utilisateurs concernés, y compris vous-même dès le prochain affichage. C'est un comportement normal.
                </div>

                {{ form_start(form) }}

                {{ form_row(form.label) }}

                {# Start date + end date on the same line #}
                <div class="row mb-3">
                    <div class="col-md-6">
                        {{ form_row(form.startDate) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.endDate) }}
                    </div>
                </div>

                {{ form_row(form.active) }}

                <div class="d-flex justify-content-between mt-4">
                    <a href="{{ path('training_parameters_schoolYear') }}" class="btn btn-outline-secondary">
                        Retour à la liste
                    </a>
                    <button class="btn btn-primary">
                        {{ button_label|default('Enregistrer') }}
                    </button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}

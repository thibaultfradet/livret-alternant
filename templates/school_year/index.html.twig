{% extends 'base.html.twig' %}

{% block title %}Liste des années scolaires{% endblock %}

{% block body %}
    <h1>Liste des années scolaires</h1>

    <table id="schoolYearTable" class="table table-hover text-center align-middle mb-0">
        <thead>
            <tr>
                <th>Id</th>
                <th>Libellé</th>
                <th>Date de début</th>
                <th>Date de fin</th>
                <th>Active</th>
                <th>Condition du livret sur l'année</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for school_year in school_years %}
            <tr>
                <td>{{ school_year.id }}</td>
                <td>{{ school_year.label }}</td>
                <td>{{ school_year.startDate ? school_year.startDate|date('d/m/Y') : '' }}</td>
                <td>{{ school_year.endDate ? school_year.endDate|date('d/m/Y') : '' }}</td>
                <td>{{ school_year.active ? 'Oui' : 'Non' }}</td>
                <td>{{ school_year.termsContent }}</td>
                <td>
                    <a href="{{ path('app_school_year_show', {'id': school_year.id}) }}">Afficher</a>
                    <a href="{{ path('app_school_year_edit', {'id': school_year.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">Aucun enregistrement trouvé.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_school_year_new') }}">Ajouter une année scolaire</a>
{% endblock %}

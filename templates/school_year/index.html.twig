{% extends 'base.html.twig' %}

{% block title %}Liste des années scolaires{% endblock %}

{% block body %}
<div class="container my-5">

    <!-- Ligne 1 : titre centré -->
    <div class="row mb-3">
        <div class="col text-center">
            <h1 class="fw-bold text-primary mb-5 display-5 text-center">Liste des années scolaires</h1>
        </div>
    </div>

    <!-- Ligne 2 : bouton aligné à droite -->
    <div class="row mb-3">
        <div class="col text-end">
            <a href="{{ path('app_school_year_new') }}" class="btn btn-primary">Ajouter une année scolaire</a>
        </div>
    </div>

    <!-- Ligne 3 : tableau -->
    <div class="row">
        <div class="col">
            <div class="card shadow-sm">
                <div class="table-responsive">
                    <table id="schoolYearTable" class="table table-hover text-center align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Id</th>
                                <th>Libellé</th>
                                <th>Date de début</th>
                                <th>Date de fin</th>
                                <th>Active</th>
                                <th>Condition du livret</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for school_year in school_years %}
                            <tr>
                                <td>{{ school_year.id }}</td>
                                <td>{{ school_year.label }}</td>
                                <td>{{ school_year.startDate ? school_year.startDate|date('d/m/Y') : '' }}</td>
                                <td>{{ school_year.endDate ? school_year.endDate|date('d/m/Y') : '' }}</td>
                                <td>{{ school_year.active ? 'Oui' : 'Non' }}</td>
                                <td>{{ school_year.termsContent|slice(0, 100) ~ (school_year.termsContent|length > 100 ? '...' : '') }}</td>
                                <td class="text-center">
                                    <a href="{{ path('app_school_year_show', {'id': school_year.id}) }}" class="btn btn-outline-primary me-2">Afficher</a>
                                    <a href="{{ path('app_school_year_edit', {'id': school_year.id}) }}" class="btn btn-primary">Modifier</a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-muted">Aucun enregistrement trouvé.</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}
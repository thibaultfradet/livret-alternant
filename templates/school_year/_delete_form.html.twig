<form method="post" action="{{ path('app_school_year_delete', {'id': school_year.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer l'année scolaire ??');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ school_year.id) }}">
    <button class="btn btn-red">Supprimer</button>
</form>

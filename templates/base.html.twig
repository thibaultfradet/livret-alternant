<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
    <meta http-equiv="X-UA-Compatible" content="ie=edge"/>
    <link rel="icon" href="data:,">
    <title>{% block title %}{% endblock %}</title>
    
   {% block stylesheets %}
        <link href="{{ asset('assets/styles/app.css') }}" rel="stylesheet">  
        <link href="{{ asset('assets/styles/datatable.min.css') }}" rel="stylesheet">              
        <link href="{{ asset('assets/styles/tabler.min.css') }}" rel="stylesheet">   
    {% endblock %}

     {% block javascripts %}
        <script src="{{ asset('js/jquery-3.7.1.min.js') }}"></script>
        <script src="{{ asset('/assets/js/tabler.min.js') }}"></script>
        <script src="{{ asset('/assets/js/datatable.min.js') }}"></script>
        <script src="{{ asset('/assets/js/datatable/index.js') }}"></script>
    {% endblock %}
    
  </head>
  <body >
     <div class="page">
        <div class="sticky-top">
            {% include('menu/topnav.html.twig') %}
        </div>
        <div class="page-wrapper">
          <div class="container">
            {% for label, messages in app.flashes %}
              {% for message in messages %}
                {% set bs_class =
                  label == 'success' ? 'alert-success' :
                  label == 'error'   ? 'alert-danger'  :
                  label == 'warning' ? 'alert-warning' :
                  'alert-info' %}
                <div class="alert {{ bs_class }} alert-dismissible fade show" role="alert">
                  {{ message }}
                  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
              {% endfor %}
            {% endfor %}
          </div>
          {% block body %}{% endblock %}
        </div>
        {% include 'menu/footer.html.twig' %}
     </div>
    {% block javascripts_bottom %}{% endblock %}
    </body>
</html>

{% extends 'base.html.twig' %}

{% block title %}Créer un niveau{% endblock %}

{% block body %}
<div class="container mt-5" style="max-width: 600px;">
    <h1 class="fw-bold text-primary mb-4 text-center">
        Ajouter un niveau
    </h1>

    {{ form_start(form) }}

        {# Label field #}
        <div class="mb-3">
            {{ form_label(form.label) }}
            {{ form_widget(form.label, { attr: { class: 'form-control' } }) }}
            {{ form_errors(form.label) }}
        </div>

        {# Color field #}
       <div class="mb-3">
            {{ form_label(form.color) }}
            {{ form_widget(form.color, { attr: { class: 'form-control' } }) }}
            {{ form_errors(form.color) }}
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a href="{{ app.request.headers.get('referer') }}" class="btn btn-light">
                Annuler
            </a>
            <button class="btn btn-primary">
                Valider
            </button>
        </div>

    {{ form_end(form) }}
</div>
{% endblock %}
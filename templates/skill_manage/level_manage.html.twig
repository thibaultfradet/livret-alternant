{% extends 'base.html.twig' %}

{% block title %}Gestion des niveaux{% endblock %}

{% block body %}
<div class="container mt-4 text-primary">

    <h1 class="fw-bold text-primary mb-5 display-5 text-center">
        Gestion des niveaux de compétence
    </h1>

    {# Top actions #}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a href="{{ path('app_skill_management', { id: diploma.id }) }}"
           class="btn btn-light">
            ← Retour à la gestion des compétences
        </a>

        <a href="{{ path('app_skill_level_create') }}"
           class="btn btn-primary">
            + Ajouter un niveau
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <table class="table table-bordered align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Libellé</th>
                        <th class="text-end">Statut</th>
                    </tr>
                </thead>
                <tbody>
                    {% for level in levels %}
                        <tr>
                            <td>{{ level.label }}</td>
                            <td class="text-end">
                                {% if level.disabledAt is null %}
                                    <a href="{{ path('app_skill_level_toggle', { type: 'level', id: level.id }) }}"
                                       class="text-danger"
                                       onclick="return confirm('Désactiver ce niveau ? Cette action est irréversible.');">
                                        Désactiver
                                    </a>
                                {% else %}
                                    <span class="text-muted">Désactivé</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="2" class="text-center text-muted">
                                Aucun niveau défini.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

        </div>
    </div>

</div>
{% endblock %}
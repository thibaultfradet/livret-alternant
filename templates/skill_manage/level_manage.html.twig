{% extends 'base.html.twig' %}

{% block title %}Gestion des niveaux{% endblock %}

{% block body %}
<div class="container mt-4 text-primary">

    <h1 class="fw-bold text-primary mb-5 display-5 text-center">
        Gestion des niveaux de compétence
    </h1>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <a href="{{ path('app_skill_management', { id: diploma.id }) }}"
           class="btn btn-outline-secondary">
            ← Retour à la gestion des compétences
        </a>

        <a href="{{ path('app_skill_level_create') }}"
           class="btn btn-primary">
            + Ajouter un niveau
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <table class="table table-bordered align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:40px;"></th>
                        <th>Libellé</th>
                        <th>Couleur</th>
                        <th class="text-end">Statut</th>
                    </tr>
                </thead>

                <tbody id="sortable-levels">
                    {% for level in levels %}
                        <tr data-id="{{ level.id }}">
                            <td class="text-center cursor-grab">☰</td>
                            <td>{{ level.label }}</td>

                            <td>
                                {% if level.color %}
                                    <span style="display:inline-block;width:24px;height:24px;border-radius:4px;background-color:{{ level.color }};"></span>
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endif %}
                            </td>

                            <td class="text-end">
                                <form class="d-inline" method="post"
                                      action="{{ path('app_skill_level_toggle', { id: level.id }) }}"
                                      onsubmit="return confirm('Supprimer ce niveau ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle_skill_level' ~ level.id) }}">
                                    <button type="submit" class="btn btn-link text-danger p-0">Supprimer</button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center text-muted">
                                Aucun niveau défini.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

        </div>
    </div>
</div>

{# SortableJS #}
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const tbody = document.getElementById('sortable-levels');

    new Sortable(tbody, {
        animation: 150,
        handle: '.cursor-grab',
        onEnd: () => {
            const order = [...tbody.querySelectorAll('tr')]
                .map((tr, index) => ({
                    id: tr.dataset.id,
                    position: index + 1
                }));

            fetch('{{ path('app_skill_level_reorder') }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest',
                    'X-CSRF-Token': '{{ csrf_token('reorder_skill_levels') }}'
                },
                body: JSON.stringify({ order })
            });
        }
    });
});
</script>
{% endblock %}
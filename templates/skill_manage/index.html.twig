{% extends 'base.html.twig' %}

{% block title %}Gestion des compétences{% endblock %}

{% block body %}
<div class="container mt-4 text-center text-primary">
    <h1>Gestion des critères, niveaux et groupes de compétence</h1>

    <div class="d-flex align-items-center justify-content-between mb-4 p-3 rounded">
        {# filter diplome #}
        <div>
            <select class="form-select" onchange="window.location.href=this.value">
                {% for diploma in diplomas %}
                    <option value="{{ path('app_skill_management', {id: diploma.id}) }}"
                        {% if diploma.id == selectedDiploma.id %}selected{% endif %}>
                        {{ diploma.label }}
                    </option>
                {% endfor %}
            </select>
        </div>
        {# general manage actions #}
        <div>
            <button class="btn btn-warning" 
                data-bs-toggle="modal" 
                data-bs-target="#modalAddSkillGroup"
                id="btn-create-group"
                data-diploma-id="{{ selectedDiploma.id }}"
            >
                + Créer un groupe
            </button>
            <button class="btn btn-primary me-2" data-bs-toggle="modal" data-bs-target="#modalLevel">
                Gérer les niveaux
            </button>
        </div>
    </div>
    <hr style="border: 2px solid black; margin: 2rem 0;">

    {# Card synthétique des groupes #}
    <div class="card mb-4">
        <div class="card-body">
            <h3 class="text-start fw-bold mb-3">Groupes de compétence</h3>
            <table id="groups-summary" class="table table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="text-start">Groupe de compétence</th>
                        <th class="text-end">Désactivé</th>
                    </tr>
                </thead>
                <tbody>
                    {% for group in selectedDiploma.skillGroups %}
                        <tr data-group-id="{{ group.id }}">
                            <td class="text-start">{{ group.label }}</td>
                            <td class="text-end">
                                <div class="form-check form-switch d-inline-block">
                                    <input class="form-check-input js-toggle-group-status" type="checkbox"
                                        role="switch"
                                        data-id="{{ group.id }}"
                                        data-label="{{ group.label }}"
                                        {% if group.disabledAt %}checked{% endif %}>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="2" class="text-center text-muted">Aucun groupe défini pour ce diplôme.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>


    <hr style="border: 2px solid black; margin: 2rem 0;">

    {# for each group we show skills label && add skills to group #}
    {% for group in selectedDiploma.skillGroups %}
        <div class="card mb-4" id="group-card-{{ group.id }}">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="text-start fw-bold mb-0">Groupe : {{ group.label }}</h3>
                    <button class="btn btn-sm btn-primary"
                            data-bs-toggle="modal" 
                            data-bs-target="#modalAddSkill"
                            data-group-id="{{ group.id }}"
                            data-group-label="{{ group.label }}">
                        + Ajouter compétence
                    </button>
                </div>
                
                <table class="table table-bordered mt-2 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="text-start">Libellé</th>
                            <th class="text-end">Désactivé</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for skill in group.skillCriteria %}
                            <tr>
                                <td class="text-start">{{ skill.label }}</td>
                                <td class="text-end">
                                    <div class="form-check form-switch d-inline-block">
                                        <input class="form-check-input js-toggle-status" type="checkbox"
                                            role="switch"
                                            data-id="{{ skill.id }}"
                                            {% if skill.disabledAt %}checked{% endif %}>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="2" class="text-center text-muted">Aucune compétence.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% else %}
        <p class="text-muted text-center">Aucun groupe défini pour ce diplôme.</p>
    {% endfor %}

</div>

{# include modal #}
{% include 'components/modal_add_level.html.twig' %}
{% include 'components/modal_add_skill.html.twig' %}
{% include 'components/modal_add_skillgroup.html.twig' %}
{% include 'components/modal_level.html.twig' %}

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/jquery-3.7.1.min.js') }}"></script>
    <script src="{{ asset('js/skill_group_management.js') }}"></script>
    <script src="{{ asset('js/level_management.js') }}"></script>

{% endblock %}

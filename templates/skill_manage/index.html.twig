{% extends 'base.html.twig' %}

{% block title %}Gestion des compétences{% endblock %}

{% block body %}
<div class="container mt-4 text-primary">

    <h1 class="fw-bold text-primary mb-5 display-5 text-center">
        Gestion des critères, niveaux et groupes de compétence
    </h1>

    {# Top actions & diploma filter #}
    <div class="d-flex align-items-center justify-content-between mb-4 p-3 rounded">
        <div>
            <select class="form-select" onchange="window.location.href=this.value">
                {% for diploma in diplomas %}
                    <option value="{{ path('app_skill_management', { id: diploma.id }) }}"
                        {% if diploma.id == selectedDiploma.id %}selected{% endif %}>
                        {{ diploma.label }}
                    </option>
                {% endfor %}
            </select>
        </div>

        <div class="d-flex gap-2">
            <a href="{{ path('app_skill_group_create', { diploma: selectedDiploma.id }) }}"
               class="btn btn-warning">
                + Créer un groupe
            </a>

           <a href="{{ path('app_skill_level_manage') }}"
                class="btn btn-primary">
                Gérer les niveaux
            </a>
        </div>
    </div>

    <hr class="border border-dark border-2 my-4">

    {# Groups summary #}
    <div class="card mb-4">
        <div class="card-body">
            <h3 class="text-start fw-bold mb-3">Groupes de compétence</h3>

            <table class="table table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="text-start">Groupe</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for group in selectedDiploma.skillGroups %}
                        <tr>
                            <td class="text-start">{{ group.label }}</td>
                            <td class="text-end">
                                {% if group.disabledAt is null %}
                                    <a href="{{ path('app_toggle_status', { type: 'group', id: group.id }) }}"
                                       class="text-danger"
                                       onclick="return confirm('Désactiver ce groupe ? Action irréversible.');">
                                        Désactiver
                                    </a>
                                {% else %}
                                    <span class="text-muted">Désactivé</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="2" class="text-center text-muted">
                                Aucun groupe défini pour ce diplôme.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <hr class="border border-dark border-2 my-4">

    {# Skills per group #}
    {% for group in selectedDiploma.skillGroups %}
        <div class="card mb-4">
            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="fw-bold mb-0">
                        Groupe : {{ group.label }}
                    </h3>

                    <a href="{{ path('app_skill_criteria_create', { group: group.id }) }}"
                       class="btn btn-primary">
                        + Ajouter compétence
                    </a>
                </div>

                <table class="table table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="text-start">Compétence</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for skill in group.skillCriteria %}
                            <tr>
                                <td class="text-start">{{ skill.label }}</td>
                                <td class="text-end">
                                    {% if skill.disabledAt is null %}
                                        <a href="{{ path('app_toggle_status', { type: 'skill', id: skill.id }) }}"
                                           class="text-danger"
                                           onclick="return confirm('Désactiver cette compétence ? Action irréversible.');">
                                            Désactiver
                                        </a>
                                    {% else %}
                                        <span class="text-muted">Désactivée</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="2" class="text-center text-muted">
                                    Aucune compétence.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% else %}
        <p class="text-muted text-center">
            Aucun groupe défini pour ce diplôme.
        </p>
    {% endfor %}

</div>
{% endblock %}
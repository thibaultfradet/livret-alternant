{% extends 'base.html.twig' %}

{% block title %}Gestion des compétences{% endblock %}

{% block body %}
<div class="container mt-4 text-primary">

    <h1 class="fw-bold text-primary mb-5 display-5 text-center">
        Gestion des critères, niveaux et groupes de compétence
    </h1>

    {# Top actions & diploma filter #}
    <div class="d-flex align-items-center justify-content-between mb-4 p-3 rounded">
        <div>
            <select class="form-select" onchange="window.location.href=this.value">
                {% for diploma in diplomas %}
                    <option value="{{ path('app_skill_management', { id: diploma.id }) }}"
                        {% if diploma.id == selectedDiploma.id %}selected{% endif %}>
                        {{ diploma.label }}
                    </option>
                {% endfor %}
            </select>
        </div>

        <div class="d-flex gap-2">
            <a href="{{ path('app_skill_group_create', { diploma: selectedDiploma.id }) }}"
               class="btn btn-warning">
                + Créer un groupe
            </a>

           <a href="{{ path('app_skill_level_manage') }}"
                class="btn btn-primary">
                Gérer les niveaux
            </a>
        </div>
    </div>

    <hr class="border border-dark border-2 my-4">
    <h1 class="text-start fw-bold mb-3">Groupes de compétence associés</h1>

    {# Groups summary #}
    <div class="card mb-4">
        <div class="card-body">

            <table class="table table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="text-start">Groupe</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% set hasGroups = false %}
                    {% for group in selectedDiploma.skillGroups %}
                        {% if group.disabledAt is null %}
                            {% set hasGroups = true %}
                            <tr>
                                <td class="text-start">{{ group.label }}</td>
                                <td class="text-end">
                                    <form class="d-inline" method="post"
                                          action="{{ path('app_toggle_status', { type: 'group', id: group.id }) }}"
                                          onsubmit="return confirm('Supprimer ce groupe ? Action irréversible.');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('togglegroup' ~ group.id) }}">
                                        <button type="submit" class="btn btn-link text-danger p-0">Supprimer</button>
                                    </form>
                                </td>
                            </tr>
                        {% endif %}
                    {% endfor %}

                    {% if not hasGroups %}
                        <tr>
                            <td colspan="2" class="text-center text-muted">
                                Aucun groupe actif pour ce diplôme.
                            </td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>

    <hr class="border border-dark border-2 my-4">
    <h1 class="text-start fw-bold mb-3">Liste des compétences associées</h1>

    {# Skills per group #}
    {% set hasActiveGroups = false %}
    {% for group in selectedDiploma.skillGroups %}
        {% if group.disabledAt is null %}
            {% set hasActiveGroups = true %}
            <div class="card mb-4">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h3 class="fw-bold mb-0">
                            Groupe : {{ group.label }}
                        </h3>

                        <a href="{{ path('app_skill_criteria_create', { group: group.id }) }}"
                           class="btn btn-primary">
                            + Ajouter compétence
                        </a>
                    </div>

                    <table class="table table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th class="text-start">Compétence</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% set hasSkills = false %}
                            {% for skill in group.skillCriteria %}
                                {% if skill.disabledAt is null %}
                                    {% set hasSkills = true %}
                                    <tr>
                                        <td class="text-start">{{ skill.label }}</td>
                                        <td class="text-end">
                                            <form class="d-inline" method="post"
                                                  action="{{ path('app_toggle_status', { type: 'skill', id: skill.id }) }}"
                                                  onsubmit="return confirm('Supprimer cette compétence ? Action irréversible.');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('toggleskill' ~ skill.id) }}">
                                                <button type="submit" class="btn btn-link text-danger p-0">Supprimer</button>
                                            </form>
                                        </td>
                                    </tr>
                                {% endif %}
                            {% endfor %}

                            {% if not hasSkills %}
                                <tr>
                                    <td colspan="2" class="text-center text-muted">
                                        Aucune compétence active.
                                    </td>
                                </tr>
                            {% endif %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% endif %}
    {% endfor %}

    {% if not hasActiveGroups %}
        <p class="text-muted text-center">
            Aucun groupe actif pour ce diplôme.
        </p>
    {% endif %}

</div>
{% endblock %}
{% set navigation_config = {
    'ROLE_ADMIN': {
        'title': 'Administrateur',
        'links': [
            { 'label': 'Gérer les établissements', 'path': 'admin' }
        ]
    },
    'ROLE_PT': {
        'title': 'Professeur réféfrent',
        'links': [
            { 'label': 'Validations des livrets', 'path': 'app_evaluation_visualizer' },
        ]
    },
    'ROLE_TUTOR': {
        'title': 'Tuteur',
        'links': [
            { 'label': 'Livret des alternants', 'path': 'app_evaluation_list_tutor' },
            { 'label': 'Calendrier & EDT', 'path': 'app_calendar_schedule' }
        ]
    },
    'ROLE_STUDENT': {
        'title': 'Alternant',
        'links': [
            { 'label': 'Calendrier & EDT', 'path': 'app_calendar_schedule' },
            { 'label': 'Équipe pédagogique', 'path': 'app_ttm_list' },
            { 'label': 'Livret', 'path': 'app_evaluation_list_student' },

        ]
    },
    'ROLE_TTM': {
        'title': 'Équipe pédagogique',
        'links': [
            { 'label': 'Validations des livrets', 'path': 'app_evaluation_visualizer' },
            { 'label': 'Évaluer un alternant', 'path': 'app_evaluation_list_ttm' },
            { 'label': 'Paramétrage', 'path': 'training_parameters' },
            { 'label': 'Centre de formation','path':'app_establishment_view' },
        ]
    }
} %}

{% set user_nav_roles = [] %}
{% if app.user %}
    {% for role in app.user.roles %}
        {% if role in navigation_config|keys|join('') %}
            {% set user_nav_roles = user_nav_roles|merge([role]) %}
        {% endif %}
    {% endfor %}
{% endif %}

<nav class="navbar navbar-expand-lg navbar-light bg-body border-bottom">
    <div class="container-fluid">
        <a href="{{ path('app_home') }}" class="navbar-brand d-flex align-items-center">
            <img src="{{ asset('images/logo_bleu.png') }}" alt="Logo" class="navbar-brand-image me-2" style="height: 56px;">
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topnavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="topnavMenu">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                {% if user_nav_roles|length > 1 %}
                    {% for role in user_nav_roles %}
                        {% set config = navigation_config[role] %}
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="nav-dropdown-{{ role }}" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                {{ config.title }}
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="nav-dropdown-{{ role }}">
                                {% for item in config.links %}
                                    {% if item.is_dropdown is defined and item.is_dropdown %}
                                        <li class="dropdown-submenu">
                                            <a class="dropdown-item dropdown-toggle" href="#">{{ item.label }}</a>
                                            <ul class="dropdown-menu">
                                                {% for sub_item in item.links %}
                                                    <li><a class="dropdown-item" href="{{ path(sub_item.path) }}">{{ sub_item.label }}</a></li>
                                                {% endfor %}
                                            </ul>
                                        </li>
                                    {% else %}
                                        <li><a class="dropdown-item" href="{{ path(item.path) }}">{{ item.label }}</a></li>
                                    {% endif %}
                                {% endfor %}
                            </ul>
                        </li>
                    {% endfor %}
                {% elseif user_nav_roles|length == 1 %}
                    {% set role = user_nav_roles|first %}
                    {% set config = navigation_config[role] %}
                    {% for item in config.links %}
                        {% if item.is_dropdown is defined and item.is_dropdown %}
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="nav-dropdown-single-{{ role }}" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    {{ item.label }}
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="nav-dropdown-single-{{ role }}">
                                    {% for sub_item in item.links %}
                                        <li><a class="dropdown-item" href="{{ path(sub_item.path) }}">{{ sub_item.label }}</a></li>
                                    {% endfor %}
                                </ul>
                            </li>
                        {% else %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path(item.path) }}">{{ item.label }}</a>
                            </li>
                        {% endif %}
                    {% endfor %}
                {% endif %}
            </ul>

           <ul class="navbar-nav ms-auto">
                {% if app.user %}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="profileDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="avatar bg-primary text-white fw-bold rounded-circle d-flex align-items-center justify-content-center me-2" style="width:36px; height:36px; font-size:16px;">
                                {{ app.user.firstName|slice(0,1)|upper }}
                            </span>
                            {{ app.user.firstName ~ ' ' ~ app.user.lastName }}
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profileDropdown">
                            <li><a class="dropdown-item" href="{{ path('app_logout') }}">Se déconnecter</a></li>
                        </ul>
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>

<style>
.dropdown-submenu {
  position: relative;
}

.dropdown-submenu > .dropdown-menu {
  top: 0;
  left: 100%;
  margin-top: -0.125rem;
}
</style>

<script>
document.querySelectorAll('.dropdown-submenu .dropdown-toggle').forEach(function (element) {
    element.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        let submenu = this.nextElementSibling;
        submenu.classList.toggle('show');
    });
});
</script>
{% set navigation_config = {
    'ROLE_SUPER_ADMIN': {
        'title': 'Super administrateur',
        'links': [
            { 'label': 'Gérer les établissements', 'path': 'app_home' }
        ]
    },
    'ROLE_ADMIN': {
        'title': 'Administrateur',
        'links': [
        ]
    },
    'ROLE_TUTOR': {
        'title': 'Tuteur',
        'links': [
            { 'label': 'Livrets de mes alternants', 'path': 'app_evaluation_list_tutor' }
        ]
    },
    'ROLE_STUDENT': {
        'title': 'Alternant',
        'links': [
            { 'label': 'Calendrier & EDT', 'path': 'app_calendar_schedule' },
            { 'label': 'Livret', 'path': 'app_evaluation_list_student' },
            { 'label': 'Équipe pédagogique', 'path': 'app_ttm_list' }
        ]
    },
    'ROLE_TTM': {
        'title': 'Membre de l\'équipe pédagogique',
        'links': [
            { 'label': 'Gérer les diplômes', 'path': 'app_diploma_index' },
            { 'label': 'Gérer les utilisateurs', 'path': 'app_user_index' },
            { 'label': 'Validations des livrets', 'path': 'app_evaluation_visualizer' },
            { 'label': 'Evaluer un alternant (livret)', 'path': 'app_evaluation_list_ttm' },
            { 
                'label': 'Gestion',
                'is_dropdown': true,
                'links': [
                    { 'label': 'Classes', 'path': 'app_classroom_index' },
                    { 'label': 'Compétences', 'path': 'app_skill_management' },
                    { 'label': 'Comportements', 'path': 'app_behavior_manage' },
                    { 'label': 'Années scolaires', 'path': 'app_school_year_index' },
                    { 'label': 'Périodes','path':'app_period_index' }
                ]
            }
        ]
    }
} %}

{# Get the user roles that are configured for navigation #}
{% set user_nav_roles = [] %}
{% if app.user %}

    {% for role in app.user.roles %}
            {% if role in navigation_config|keys|join('') %}
                {% set user_nav_roles = user_nav_roles|merge([role]) %}

        {% endif %}
    {% endfor %}
{% endif %}


<nav class="navbar navbar-expand-lg navbar-dark shadow-sm">
    <div class="container-fluid">
       <a href="{{ path('app_home') }}">
            <div>
                <img src="{{ asset('images/logo_bleu_zoom.png') }}" alt="Logo campus" class="img-fluid" style="max-width: 100px; max-height: 100px;">
            </div>
        </a>
        <a class="navbar-brand" href="{{ path('app_home') }}">Livret Alternant</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topnavMenu" aria-controls="topnavMenu" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="topnavMenu">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                {# CASE 1: User has multiple relevant roles -> Create a dropdown for each role #}
                {% if user_nav_roles|length > 1 %}
                    {% for role in user_nav_roles %}
                        {% set config = navigation_config[role] %}
                        <li class="nav-item dropdown">
                            <a class="nav-link text-dark dropdown-toggle" href="#" id="nav-dropdown-{{ role }}" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                {{ config.title }}
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="nav-dropdown-{{ role }}">
                                {% for item in config.links %}
                                    {# Handles the "Gestion" submenu for the TTM role #}
                                    {% if item.is_dropdown is defined and item.is_dropdown %}
                                        <li class="dropdown-submenu">
                                             <a class="dropdown-item dropdown-toggle" href="#">{{ item.label }}</a>
                                             <ul class="dropdown-menu">
                                                 {% for sub_item in item.links %}
                                                     <li><a class="dropdown-item" href="{{ path(sub_item.path) }}">{{ sub_item.label }}</a></li>
                                                 {% endfor %}
                                             </ul>
                                        </li>
                                    {% else %}
                                        <li><a class="dropdown-item" href="{{ path(item.path) }}">{{ item.label }}</a></li>
                                    {% endif %}
                                {% endfor %}
                            </ul>
                        </li>
                    {% endfor %}

                {# CASE 2: User has only one relevant role -> Display links directly #}
                {% elseif user_nav_roles|length == 1 %}
                
                    {% set role = user_nav_roles|first %}
                    {% set config = navigation_config[role] %}
                    {% for item in config.links %}
                        {% if item.is_dropdown is defined and item.is_dropdown %}
                            <li class="nav-item dropdown">
                                <a class="nav-link text-dark dropdown-toggle" href="#" id="nav-dropdown-single-{{ role }}" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    {{ item.label }}
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="nav-dropdown-single-{{ role }}">
                                    {% for sub_item in item.links %}
                                        <li><a class="dropdown-item" href="{{ path(sub_item.path) }}">{{ sub_item.label }}</a></li>
                                    {% endfor %}
                                </ul>
                            </li>
                        {% else %}
                             <li class="nav-item">
                                <a class="nav-link text-dark" href="{{ path(item.path) }}">{{ item.label }}</a>
                            </li>
                        {% endif %}
                    {% endfor %}
                {% endif %}

            </ul>

            {# User profile section (unchanged) #}
            <ul class="navbar-nav ms-auto">
                {% if app.user %}
                    <li class="nav-item dropdown">
                        <a class="nav-link text-dark dropdown-toggle" href="#" id="profileDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            {{ app.user.firstName ~ ' ' ~ app.user.lastName }}
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profileDropdown">
                            <li><a class="dropdown-item" href="{{ path('app_logout') }}">Se déconnecter</a></li>
                        </ul>
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>
<style>
.dropdown-submenu {
  position: relative;
}

.dropdown-submenu > .dropdown-menu {
  top: 0;
  left: 100%;
  margin-top: -0.125rem;
}

</style>


<script>
document.querySelectorAll('.dropdown-submenu .dropdown-toggle').forEach(function (element) {
    element.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        let submenu = this.nextElementSibling;
        submenu.classList.toggle('show');
    });
});
</script>

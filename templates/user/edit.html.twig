{% extends 'base.html.twig' %}

{% block title %}Modifier un utilisateur{% endblock %}

{% block body %}
<div class="page page-center">
    <div class="container">

        <div class="text-center mb-5">
            <h1 class="fw-bold text-primary display-5">
                Modifier un utilisateur
            </h1>
            <p class="text-muted">
                {{ user.firstName }} {{ user.lastName }}
            </p>
        </div>

        <div class="card shadow-sm">
            <div class="card-header">
                <ul class="nav nav-tabs card-header-tabs" id="userTypeTabs" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link {% if isStudent %}active{% endif %}" id="student-tab-link" data-bs-toggle="tab" href="#student" role="tab">Élève</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {% if not isStudent and 'ROLE_PT' in user.roles %}active{% endif %}" id="teacher-tab-link" data-bs-toggle="tab" href="#teacher" role="tab">Professeur référent</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {% if not isStudent and 'ROLE_PT' not in user.roles %}active{% endif %}" id="team-tab-link" data-bs-toggle="tab" href="#team" role="tab">Membre équipe pédagogique</a>
                    </li>
                </ul>
            </div>

            <div class="card-body">
                {{ form_start(form) }}

                {# Hidden checkboxes for role determination #}
                <div class="d-none">
                    {{ form_widget(form.isProfPrincipal) }}
                    {{ form_widget(form.isTeamMember) }}
                </div>

                {# Common fields for all user types #}
                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(form.email) }}
                    </div>
                    <div class="col-md-6 phone-field {% if isStudent or ('ROLE_PT' not in user.roles) %}d-none{% endif %}">
                        {{ form_row(form.phone) }}
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(form.firstName) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.lastName) }}
                    </div>
                </div>

                {# Tab content for role-specific fields #}
                <div class="tab-content mt-3">
                    {# Student tab #}
                    <div class="tab-pane fade {% if isStudent %}show active{% endif %}" id="student" role="tabpanel">
                        <div class="row">
                            <div class="col-md-6">
                                {{ form_row(form.classroom) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(form.isApprentissage) }}
                            </div>
                        </div>

                        <hr class="my-4">

                        <h4 class="mb-3">Informations de l'entreprise</h4>
                        <div class="row">
                            <div class="col-md-6">
                                {{ form_row(form.companyName) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(form.companyAddress) }}
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                {{ form_row(form.dateDebutContract) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(form.dateFinContract) }}
                            </div>
                        </div>

                        <h4 class="mt-4 mb-3">Informations du tuteur</h4>
                        <div class="row">
                            <div class="col-md-6">
                                {{ form_row(form.tutorFirstName) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(form.tutorLastName) }}
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                {{ form_row(form.tutorEmail) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(form.tutorPhone) }}
                            </div>
                        </div>
                    </div>

                    {# Teacher tab #}
                    <div class="tab-pane fade {% if not isStudent and 'ROLE_PT' in user.roles %}show active{% endif %}" id="teacher" role="tabpanel">
                        <div class="alert alert-info">
                            Un professeur référent peut suivre les évaluations des élèves de sa classe.
                        </div>
                    </div>

                    {# Team member tab #}
                    <div class="tab-pane fade {% if not isStudent and 'ROLE_PT' not in user.roles %}show active{% endif %}" id="team" role="tabpanel">
                        <div class="alert alert-info">
                            Un membre de l'équipe pédagogique peut gérer les utilisateurs et les paramètres de formation.
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-footer d-flex justify-content-between">
                <a href="{{ path('training_parameters_user') }}" class="btn btn-outline-secondary">
                    ← Retour à la liste
                </a>
                <button class="btn btn-primary" type="submit">Mettre à jour</button>
            </div>

            {{ form_end(form) }}
        </div>

    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const isProfPrincipal = document.getElementById('{{ form.isProfPrincipal.vars.id }}');
    const isTeamMember = document.getElementById('{{ form.isTeamMember.vars.id }}');
    const phoneField = document.querySelector('.phone-field');

    // Reset checkboxes when tab changes
    document.querySelectorAll('#userTypeTabs a[data-bs-toggle="tab"]').forEach(function(tab) {
        tab.addEventListener('shown.bs.tab', function(event) {
            // Uncheck all role checkboxes first
            isProfPrincipal.checked = false;
            isTeamMember.checked = false;

            // Hide phone field by default
            phoneField.classList.add('d-none');

            // Check the appropriate checkbox based on tab
            if (event.target.id === 'teacher-tab-link') {
                isProfPrincipal.checked = true;
                phoneField.classList.remove('d-none');
            } else if (event.target.id === 'team-tab-link') {
                isTeamMember.checked = true;
            }
        });
    });
});
</script>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Modifier un utilisateur{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('assets/styles/tom-select.bootstrap5.min.css') }}" rel="stylesheet">
    <style>
        .ts-dropdown {
            background-color: #fff !important;
            z-index: 1055 !important;
            box-shadow: 0 4px 16px rgba(0,0,0,.12);
        }
        .ts-dropdown .option {
            background-color: #fff;
        }
        .ts-dropdown .option:hover,
        .ts-dropdown .option.active {
            background-color: #e9ecef;
            color: inherit;
        }
        .contract-type-switch .form-check {
            padding-left: 0;
            min-height: unset;
            margin-bottom: 0;
        }
        .contract-type-switch .form-check-label:empty {
            display: none;
        }
    </style>
{% endblock %}

{% block body %}
<div class="page page-center">
    <div class="container">

        <div class="text-center mb-5">
            <h1 class="fw-bold text-primary display-5">
                Modifier un utilisateur
            </h1>
            <p class="text-muted">
                {{ user.firstName }} {{ user.lastName }}
            </p>
        </div>

        <div class="card shadow-sm">
            <div class="card-header">
                <ul class="nav nav-tabs card-header-tabs" id="userTypeTabs" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link {% if isStudent %}active{% endif %}" id="student-tab-link" data-bs-toggle="tab" href="#student" role="tab">Élève</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {% if not isStudent and 'ROLE_PT' in user.roles %}active{% endif %}" id="teacher-tab-link" data-bs-toggle="tab" href="#teacher" role="tab">Professeur référent</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {% if not isStudent and 'ROLE_PT' not in user.roles %}active{% endif %}" id="team-tab-link" data-bs-toggle="tab" href="#team" role="tab">Membre équipe pédagogique</a>
                    </li>
                </ul>
            </div>

            <div class="card-body">
                {{ form_start(form) }}

                {# Hidden checkboxes for role determination #}
                <div class="d-none">
                    {{ form_widget(form.isProfPrincipal) }}
                    {{ form_widget(form.isTeamMember) }}
                </div>

                {# Common fields for all user types #}
                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(form.email) }}
                    </div>
                    <div class="col-md-6 phone-field {% if isStudent or ('ROLE_PT' not in user.roles) %}d-none{% endif %}">
                        {{ form_row(form.phone) }}
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(form.firstName) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.lastName) }}
                    </div>
                </div>

                {# Tab content for role-specific fields #}
                <div class="tab-content mt-3">
                    {# Student tab #}
                    <div class="tab-pane fade {% if isStudent %}show active{% endif %}" id="student" role="tabpanel">
                        <div class="row align-items-end">
                            <div class="col-md-6">
                                {{ form_row(form.classroom) }}
                            </div>
                            <div class="col-md-6 pb-4 d-flex align-items-center justify-content-center gap-2">
                                <span id="labelPro" class="small fw-medium">Professionnalisation</span>
                                {{ form_row(form.isApprentissage, {label: false, row_attr: {class: 'form-switch mb-0 contract-type-switch'}}) }}
                                <span id="labelApp" class="small fw-medium text-muted">Apprentissage</span>
                            </div>
                        </div>

                        <hr class="my-4">

                        <h4 class="mb-3">Informations de l'entreprise</h4>
                        <div class="row">
                            <div class="col-md-6">
                                {{ form_row(form.companyName) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(form.companyAddress) }}
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                {{ form_row(form.dateDebutContract) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(form.dateFinContract) }}
                            </div>
                        </div>

                        <h4 class="mt-4 mb-3">Informations du tuteur</h4>

                        <div class="mb-3">
                            <div class="btn-group" role="group">
                                <input type="radio" class="btn-check" name="tutorMode" id="tutorModeNew" value="new" {% if not activeContract or not activeContract.tutor %}checked{% endif %} autocomplete="off">
                                <label class="btn btn-outline-primary btn-sm" for="tutorModeNew">Nouveau tuteur</label>
                                <input type="radio" class="btn-check" name="tutorMode" id="tutorModeExisting" value="existing" {% if activeContract and activeContract.tutor %}checked{% endif %} autocomplete="off">
                                <label class="btn btn-outline-primary btn-sm" for="tutorModeExisting">Tuteur existant</label>
                            </div>
                        </div>

                        <div id="existingTutorSection" class="{% if not activeContract or not activeContract.tutor %}d-none{% endif %}">
                            <div class="row">
                                <div class="col-md-12">
                                    {{ form_row(form.existingTutor) }}
                                </div>
                            </div>
                        </div>

                        <div id="newTutorSection" class="{% if activeContract and activeContract.tutor %}d-none{% endif %}">
                            <div class="row">
                                <div class="col-md-6">
                                    {{ form_row(form.tutorFirstName) }}
                                </div>
                                <div class="col-md-6">
                                    {{ form_row(form.tutorLastName) }}
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    {{ form_row(form.tutorEmail) }}
                                </div>
                                <div class="col-md-6">
                                    {{ form_row(form.tutorPhone) }}
                                </div>
                            </div>
                        </div>
                    </div>

                    {# Teacher tab #}
                    <div class="tab-pane fade {% if not isStudent and 'ROLE_PT' in user.roles %}show active{% endif %}" id="teacher" role="tabpanel">
                        <div class="alert alert-info">
                            Un professeur référent peut suivre les évaluations des élèves de sa classe.
                        </div>
                    </div>

                    {# Team member tab #}
                    <div class="tab-pane fade {% if not isStudent and 'ROLE_PT' not in user.roles %}show active{% endif %}" id="team" role="tabpanel">
                        <div class="alert alert-info">
                            Un membre de l'équipe pédagogique peut gérer les utilisateurs et les paramètres de formation.
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-footer d-flex justify-content-between">
                <a href="{{ path('training_parameters_user') }}" class="btn btn-outline-secondary">
                    ← Retour à la liste
                </a>
                <button class="btn btn-primary" type="submit">Mettre à jour</button>
            </div>

            {{ form_end(form) }}
        </div>

    </div>
</div>

{% endblock %}

{% block javascripts_bottom %}
<script src="{{ asset('assets/js/tom-select.complete.min.js') }}"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const isProfPrincipal = document.getElementById('{{ form.isProfPrincipal.vars.id }}');
    const isTeamMember = document.getElementById('{{ form.isTeamMember.vars.id }}');
    const phoneField = document.querySelector('.phone-field');

    document.querySelectorAll('#userTypeTabs a[data-bs-toggle="tab"]').forEach(function(tab) {
        tab.addEventListener('shown.bs.tab', function(event) {
            isProfPrincipal.checked = false;
            isTeamMember.checked = false;
            phoneField.classList.add('d-none');

            if (event.target.id === 'teacher-tab-link') {
                isProfPrincipal.checked = true;
                phoneField.classList.remove('d-none');
            } else if (event.target.id === 'team-tab-link') {
                isTeamMember.checked = true;
            }
        });
    });

    // Tutor mode toggle
    const tutorModeNew = document.getElementById('tutorModeNew');
    const tutorModeExisting = document.getElementById('tutorModeExisting');
    const existingTutorSection = document.getElementById('existingTutorSection');
    const newTutorSection = document.getElementById('newTutorSection');

    if (tutorModeNew && tutorModeExisting) {
        function updateTutorMode() {
            if (tutorModeExisting.checked) {
                existingTutorSection.classList.remove('d-none');
                newTutorSection.classList.add('d-none');
            } else {
                existingTutorSection.classList.add('d-none');
                newTutorSection.classList.remove('d-none');
            }
        }

        tutorModeNew.addEventListener('change', updateTutorMode);
        tutorModeExisting.addEventListener('change', updateTutorMode);
    }

    // Contract type switch labels
    const apprentissageSwitch = document.getElementById('{{ form.isApprentissage.vars.id }}');
    const labelPro = document.getElementById('labelPro');
    const labelApp = document.getElementById('labelApp');

    if (apprentissageSwitch) {
        function updateContractLabels() {
            if (apprentissageSwitch.checked) {
                labelPro.classList.add('text-muted');
                labelApp.classList.remove('text-muted');
            } else {
                labelPro.classList.remove('text-muted');
                labelApp.classList.add('text-muted');
            }
        }

        apprentissageSwitch.addEventListener('change', updateContractLabels);
        updateContractLabels();
    }

    // TomSelect on existing tutor dropdown
    const existingTutorSelect = document.getElementById('{{ form.existingTutor.vars.id }}');
    if (existingTutorSelect) {
        new TomSelect(existingTutorSelect, {
            allowEmptyOption: true,
            searchField: ['text'],
            placeholder: '-- Sélectionner un tuteur --',
            render: {
                no_results: function() {
                    return '<div class="no-results">Aucun tuteur trouvé</div>';
                }
            }
        });
    }
});
</script>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Modifier un utilisateur{% endblock %}

{% block body %}
<div class="page page-center">
    <div class="container">

        <div class="text-center mb-5">
            <h1 class="fw-bold text-primary display-5">
                Modifier un utilisateur
            </h1>
            <p class="text-muted">
                {{ user.firstName }} {{ user.lastName }}
            </p>
        </div>

        <div class="card shadow-sm">
            <div class="card-header">
                <h3 class="card-title mb-0">Informations de l'utilisateur</h3>
            </div>

            <div class="card-body">
                {{ form_start(form) }}

                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(form.email) }}
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(form.firstName) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.lastName) }}
                    </div>
                </div>

                {% if isStudent %}
                    {# Hidden checkboxes for students - preserve their non-teacher/non-team roles #}
                    <div class="d-none">
                        {{ form_widget(form.isProfPrincipal) }}
                        {{ form_widget(form.isTeamMember) }}
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            {{ form_row(form.classroom) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.isApprentissage) }}
                        </div>
                    </div>

                    {% if activeContract %}
                        <hr class="my-4">

                        <h4 class="mb-3">Informations de l'entreprise</h4>
                        <div class="row">
                            <div class="col-md-6">
                                {{ form_row(form.companyName) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(form.companyAddress) }}
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                {{ form_row(form.dateDebutContract) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(form.dateFinContract) }}
                            </div>
                        </div>

                        <h4 class="mt-4 mb-3">Informations du tuteur</h4>
                        <div class="row">
                            <div class="col-md-6">
                                {{ form_row(form.tutorFirstName) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(form.tutorLastName) }}
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                {{ form_row(form.tutorEmail) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(form.tutorPhone) }}
                            </div>
                        </div>
                    {% else %}
                        {# Render tutor fields as hidden to prevent form_end from auto-rendering them #}
                        <div class="d-none">
                            {{ form_widget(form.companyName) }}
                            {{ form_widget(form.companyAddress) }}
                            {{ form_widget(form.dateDebutContract) }}
                            {{ form_widget(form.dateFinContract) }}
                            {{ form_widget(form.tutorFirstName) }}
                            {{ form_widget(form.tutorLastName) }}
                            {{ form_widget(form.tutorEmail) }}
                            {{ form_widget(form.tutorPhone) }}
                        </div>
                    {% endif %}
                {% else %}
                    {# Hidden fields for non-students to prevent form_end from auto-rendering them #}
                    <div class="d-none">
                        {{ form_widget(form.classroom) }}
                        {{ form_widget(form.isApprentissage) }}
                        {{ form_widget(form.companyName) }}
                        {{ form_widget(form.companyAddress) }}
                        {{ form_widget(form.dateDebutContract) }}
                        {{ form_widget(form.dateFinContract) }}
                        {{ form_widget(form.tutorFirstName) }}
                        {{ form_widget(form.tutorLastName) }}
                        {{ form_widget(form.tutorEmail) }}
                        {{ form_widget(form.tutorPhone) }}
                    </div>

                    {# Visible checkboxes for non-students #}
                    <hr class="my-4">
                    <h4 class="mb-3">Rôles</h4>
                    <div class="row">
                        <div class="col-md-6">
                            {{ form_row(form.isProfPrincipal) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.isTeamMember) }}
                        </div>
                    </div>
                {% endif %}
            </div>

            <div class="card-footer d-flex justify-content-between">
                <a href="{{ path('training_parameters_user') }}" class="btn btn-outline-secondary">
                    ← Retour à la liste
                </a>

                <button class="btn btn-primary" type="submit">Mettre à jour</button>
            </div>

            {{ form_end(form) }}
        </div>

    </div>
</div>
{% endblock %}

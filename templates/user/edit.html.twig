{% extends 'base.html.twig' %}

{% block title %}Modifier un utilisateur{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="fw-bold text-primary mb-5 display-5 text-center">Modifier un utilisateur</h1>

    {{ form_start(form) }}
        {{ form_widget(form) }}
        <button class="btn btn-primary">{{ button_label|default('Mettre à jour') }}</button>
    {{ form_end(form) }}

    <div class="mt-3">
        <a href="{{ path('training_parameters_user') }}" class="btn btn-outline-secondary">Retour à la liste</a>
    </div>
</div>
{% endblock %}
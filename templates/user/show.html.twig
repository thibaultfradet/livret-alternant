{% extends 'base.html.twig' %}

{% block title %}Détail de l'utilisateur{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="mb-4">Détail de l'utilisateur</h1>

    <table class="table table-bordered table-striped">
        <tbody>
            <tr>
                <th>ID</th>
                <td>{{ user.id }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ user.email }}</td>
            </tr>
            <tr>
                <th>Rôles</th>
                <td>
                    {% for role in user.roles %}
                        <span class="badge bg-secondary">{{ role }}</span>
                    {% endfor %}
                </td>
            </tr>
            <tr>
                <th>Prénom</th>
                <td>{{ user.firstName }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ user.lastName }}</td>
            </tr>
            <tr>
                <th>Désactivé le</th>
                <td>{{ user.disabledAt ? user.disabledAt|date('Y-m-d') : '-' }}</td>
            </tr>
        </tbody>
    </table>

    <div class="mt-3">
        <a href="{{ path('app_user_index') }}" class="btn btn-secondary">Retour à la liste</a>
        <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-warning">Modifier</a>
        {{ include('user/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}
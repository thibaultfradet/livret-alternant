{% extends 'base.html.twig' %}

{% block title %}Utilisateur{% endblock %}

{% block body %}
<div class="page page-center">
    <div class="container">

        <div class="text-center mb-5">
            <h1 class="fw-bold text-primary display-5">
                Utilisateur
            </h1>
            <p class="text-muted">
                Détail de l'utilisateur sélectionné
            </p>
        </div>

        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title mb-0">
                    {{ user.firstName }} {{ user.lastName }}
                </h3>

                {% if user.disabledAt %}
                    <span class="badge bg-danger text-white">
                        Désactivé le {{ user.disabledAt|date('d/m/Y') }}
                    </span>
                {% else %}
                    <span class="badge bg-success text-white">
                        Actif
                    </span>
                {% endif %}
            </div>

            <div class="card-body">
                <div class="row g-4">
                    <div class="col-12">
                        <div class="datagrid">
                            <div class="datagrid-item">
                                <div class="datagrid-title">Email</div>
                                <div class="datagrid-content">{{ user.email }}</div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Prénom</div>
                                <div class="datagrid-content">{{ user.firstName }}</div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Nom</div>
                                <div class="datagrid-content">{{ user.lastName }}</div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Téléphone</div>
                                <div class="datagrid-content">{{ user.phone ?: '-' }}</div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Rôles</div>
                                <div class="datagrid-content">
                                    {% for role in user.roles %}
                                        {% if role == 'ROLE_TTM' %}
                                            <span class="badge bg-info text-white">Équipe pédagogique</span>
                                        {% elseif role == 'ROLE_PT' %}
                                            <span class="badge bg-warning text-white">Professeur référent</span>
                                        {% elseif role == 'ROLE_TUTOR' %}
                                            <span class="badge bg-success text-white">Tuteur</span>
                                        {% elseif role == 'ROLE_STUDENT' %}
                                            <span class="badge bg-primary text-white">Alternant</span>
                                        {% elseif role == 'ROLE_ADMIN' %}
                                            <span class="badge bg-danger text-white">Administrateur</span>
                                        {% elseif role != 'ROLE_USER' %}
                                            <span class="badge bg-secondary text-white">{{ role }}</span>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {% if activeContract %}
                    <hr class="my-4">

                    <h4 class="mb-3">Informations de l'entreprise</h4>
                    <div class="row g-4">
                        <div class="col-12">
                            <div class="datagrid">
                                <div class="datagrid-item">
                                    <div class="datagrid-title">Nom de l'entreprise</div>
                                    <div class="datagrid-content">{{ activeContract.tutor.companyName ?: '-' }}</div>
                                </div>
                                <div class="datagrid-item">
                                    <div class="datagrid-title">Adresse de l'entreprise</div>
                                    <div class="datagrid-content">{{ activeContract.tutor.companyAddress ?: '-' }}</div>
                                </div>
                                <div class="datagrid-item">
                                    <div class="datagrid-title">Période du contrat</div>
                                    <div class="datagrid-content">
                                        {{ activeContract.dateDebutContract ? activeContract.dateDebutContract|date('d/m/Y') : '-' }}
                                        <span class="text-muted mx-1">→</span>
                                        {{ activeContract.dateFinContract ? activeContract.dateFinContract|date('d/m/Y') : '-' }}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <h4 class="mt-4 mb-3">Informations du tuteur</h4>
                    <div class="row g-4">
                        <div class="col-12">
                            <div class="datagrid">
                                <div class="datagrid-item">
                                    <div class="datagrid-title">Prénom</div>
                                    <div class="datagrid-content">{{ activeContract.tutor.firstName ?: '-' }}</div>
                                </div>
                                <div class="datagrid-item">
                                    <div class="datagrid-title">Nom</div>
                                    <div class="datagrid-content">{{ activeContract.tutor.lastName ?: '-' }}</div>
                                </div>
                                <div class="datagrid-item">
                                    <div class="datagrid-title">Email</div>
                                    <div class="datagrid-content">{{ activeContract.tutor.email ?: '-' }}</div>
                                </div>
                                <div class="datagrid-item">
                                    <div class="datagrid-title">Téléphone</div>
                                    <div class="datagrid-content">{{ activeContract.tutor.phone ?: '-' }}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>

            <div class="card-footer d-flex justify-content-between">
                <a href="{{ path('training_parameters_user') }}" class="btn btn-outline-secondary">
                    ← Retour à la liste
                </a>

                <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-primary">
                    Modifier
                </a>
            </div>
        </div>

    </div>
</div>
{% endblock %}

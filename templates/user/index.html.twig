{% extends 'base.html.twig' %}

{% block title %}Liste des utilisateurs{% endblock %}

{% block body %}
<div class="container mt-5">

    <div class="row mb-3">
        <div class="col-12 text-center">
            <h1 class="fw-bold text-primary mb-5 display-5 text-center">Liste des utilisateurs</h1>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12 text-end">
            <a href="{{ path('app_user_new') }}" class="btn btn-primary">Créer un nouvel utilisateur</a>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm rounded-3">
                <div class="table-responsive">
                    <table id="users-table" class="table table-striped table-hover align-middle text-center mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th scope="col">ID</th>
                                <th scope="col">Email</th>
                                <th scope="col">Rôles</th>
                                <th scope="col">Prénom</th>
                                <th scope="col">Nom</th>
                                <th scope="col">Statut</th>
                                <th scope="col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for user in users %}
                            <tr class="{% if user.disabledAt %}table-danger{% endif %}">
                                <td>{{ user.id }}</td>
                                <td>{{ user.email }}</td>
                                <td>
                                    {% for role in user.roles %}
                                        {% if role == 'ROLE_TTM' %}
                                            <span class="badge text-white bg-cyan text-white">Équipe pédagogique</span>
                                        {% elseif role == 'ROLE_PT' %}
                                            <span class="badge text-white bg-yellow text-white">Professeur référent</span>
                                        {% elseif role == 'ROLE_TUTOR' %}
                                            <span class="badge text-white bg-green text-white">Tuteur</span>
                                        {% elseif role == 'ROLE_STUDENT' %}
                                            <span class="badge text-white bg-blue text-white">Alternant</span>
                                        {% elseif role == 'ROLE_ADMIN' %}
                                            <span class="badge text-white bg-red text-white">Administrateur</span>
                                        {% endif %}
                                    {% endfor %}
                                </td>
                                <td>{{ user.firstName }}</td>
                                <td>{{ user.lastName }}</td>
                                <td>
                                    {% if user.disabledAt %}
                                        <span class="badge text-white bg-secondary text-white">Désactivé</span>
                                    {% else %}
                                        <span class="badge text-white bg-success text-white">Actif</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if 'ROLE_ADMIN' in app.user.roles %}
                                        <a href="{{ path('app_user_show', {'id': user.id}) }}" class="btn btn-info text-white me-1">Voir</a>
                                        <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-outline-primary me-1">Modifier</a>

                                        {% if not user.disabledAt %}
                                            <form method="post" action="{{ path('app_user_disable', {'id': user.id}) }}" 
                                                  style="display:inline;" onsubmit="return confirmDisable();">
                                                <input type="hidden" name="_token" value="{{ csrf_token('disable' ~ user.id) }}">
                                                <button class="btn btn-outline-danger">Désactiver</button>
                                            </form>
                                        {% endif %}
                                    {% else %}
                                        <a href="{{ path('app_user_show', {'id': user.id}) }}" class="btn btn-info text-white">Voir</a>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center text-muted">Aucun utilisateur trouvé</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>

<script>
    function confirmDisable() {
        return confirm("⚠️ Êtes-vous sûr de vouloir désactiver cet utilisateur ?") &&
               confirm("Cette action est irréversible. Confirmez à nouveau pour continuer.");
    }
</script>
{% endblock %}
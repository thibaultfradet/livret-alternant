{% extends 'base.html.twig' %}

{% block title %}Liste des utilisateurs{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1 class="mb-4">Utilisateurs</h1>

        <a href="{{ path('app_user_new') }}" class="btn btn-primary mb-3">Créer un nouvel utilisateur</a>

        <table id="users-table" class="table table-striped table-hover align-middle text-center">
            <thead class="table-dark">
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Email</th>
                    <th scope="col">Rôles</th>
                    <th scope="col">Prénom</th>
                    <th scope="col">Nom</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for user in users %}
                <tr>
                    <td>{{ user.id }}</td>
                    <td>{{ user.email }}</td>
                    <td>
                        {% for role in user.roles %}
                            {% if role == 'ROLE_TTM' %}
                                <span class="badge bg-info text-dark">Membre de l'équipe pédagogique</span>
                            {% elseif role == 'ROLE_PT' %}
                                <span class="badge bg-warning text-dark">Professeur référent</span>
                            {% elseif role == 'ROLE_TUTOR' %}
                                <span class="badge bg-success">Tuteur</span>
                            {% elseif role == 'ROLE_STUDENT' %}
                                <span class="badge bg-primary">Alternant</span>
                            {% elseif role == 'ROLE_ADMIN' %}
                                <span class="badge bg-danger">Administrateur</span>
                            {% elseif role == 'ROLE_USER' %}
                                <p></p>
                            {% else %}
                                <span class="badge bg-light text-dark">{{ role }}</span>
                            {% endif %}
                        {% endfor %}
                    </td>
                    <td>{{ user.firstName }}</td>
                    <td>{{ user.lastName }}</td>
                    <td>
                        <a href="{{ path('app_user_show', {'id': user.id}) }}" class="btn  btn-info text-white">Voir</a>
                        <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn  btn-warning">Modifier</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="text-center text-muted">Aucun utilisateur trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
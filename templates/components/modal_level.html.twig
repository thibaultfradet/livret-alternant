<div class="modal fade" id="modalLevel" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Gestion des niveaux</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body">
        <button class="btn btn-primary mb-3 w-100" data-bs-toggle="modal" data-bs-target="#modalAddLevel">
          + Ajouter un niveau
        </button>
        <div id="list-levels">
          {% if levels is not empty %}
            <ul class="list-group">
              {% for level in levels %}
                <li class="list-group-item d-flex justify-content-between align-items-center">
                  {{ level.label }}
                  <div class="form-check form-switch">
                    <input class="form-check-input js-toggle-level-status" type="checkbox"
                           role="switch"
                           data-id="{{ level.id }}"
                           {% if level.disabledAt %}checked{% endif %}>
                    <label class="form-check-label">Désactivé</label>
                  </div>
                </li>
              {% endfor %}
            </ul>
          {% else %}
            <p class="text-muted">Aucun niveau défini.</p>
          {% endif %}
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary w-100" data-bs-dismiss="modal">Fermer</button>
      </div>
    </div>
  </div>
</div>

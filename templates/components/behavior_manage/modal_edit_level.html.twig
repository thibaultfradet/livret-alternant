<div class="modal fade" id="editLevelModal" tabindex="-1" aria-labelledby="editLevelModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editLevelModalLabel">Remplacement d'un niveau</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>

            <form method="post" id="editLevelForm">
                <div class="modal-body bg-light">

                    {# old level information #}
                    <div class="mb-3">
                        <label class="form-label fw-bold">Ancien niveau :</label>
                        <p id="oldLevelLabel" class="text-info fw-bold mb-0">-</p>
                        <input type="hidden" name="old_level_id" id="oldLevelId" value="">
                    </div>

                    {# new level information #}
                    <div class="mb-3">
                        <label for="levelLabel" class="form-label fw-bold">Nouveau libellé</label>
                        <input 
                            type="text" 
                            class="form-control" 
                            id="levelLabel" 
                            name="level_label" 
                            required 
                            placeholder="Entrez le libellé du nouveau niveau"
                        >
                        <p class="text-danger small fw-bold mt-1">
                            <i class="bi bi-exclamation-triangle-fill"></i> Attention cette action est irréversible !
                        </p>
                    </div>

                    <input type="hidden" name="level_id" id="levelId" value="">
                    <input type="hidden" name="action" id="modalAction" value="replace">
                </div>

                <div class="modal-footer d-flex justify-content-between">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-danger" id="submitLevelBtn">Valider</button>
                </div>
            </form>
        </div>
    </div>
</div>

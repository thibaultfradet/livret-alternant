{# templates/components/modal_add_skill.html.twig #}
<div class="modal fade" id="modalAddSkill" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Ajouter une compétence</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="form-add-skill">
          <div class="mb-3">
            <label for="skill-label" class="form-label">Libellé de la compétence</label>
            <input type="text" class="form-control" id="skill-label" name="label" placeholder="Nom de la compétence">
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
        <button type="button" class="btn btn-primary" id="btn-save-skill">Enregistrer</button>
      </div>
    </div>
  </div>
</div>
